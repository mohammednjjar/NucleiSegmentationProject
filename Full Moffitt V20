{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.12","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"sourceType":"datasetVersion","sourceId":14861641,"datasetId":9506865,"databundleVersionId":15722852}],"dockerImageVersionId":31329,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":true}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# =============================================================\n# Moffitt Cell Classification Pipeline\n# =============================================================\n\nimport os\nimport re\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\nimport matplotlib.patches as mpatches\nfrom tqdm.auto import tqdm\nfrom sklearn.pipeline import Pipeline\nfrom sklearn.impute import SimpleImputer\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.metrics import (\n    accuracy_score, f1_score, precision_score,\n    recall_score, ConfusionMatrixDisplay\n)\n\n# =============================================================\n# CONFIG — change only here to control the whole pipeline\n# =============================================================\nDATA_PATH   = \"/kaggle/input/datasets/mohamedaln/merged-moffitt-boundaries-cleaned-v2/merged_moffitt_boundaries_cleaned_v2.csv\"\nOUT_DIR     = \"/kaggle/working\"\nLABEL_COL   = \"Cell_class\"\nID_COLS     = [\"Cell_ID\", \"Animal_ID\"]\nSHAPE_COLS  = [\"shape_area\", \"shape_perimeter\", \"shape_circularity\"]\nMETA_COLS   = {\"Animal_ID\", \"Bregma\", \"Centroid_X\", \"Centroid_Y\"}\n\nTOP_K       = 15        # keep top-K most common classes\nBALANCE     = False     # True = downsample all classes to the smallest class count\nTEST_FRAC   = 0.20      # fraction of data used for testing\nN_TREES     = 400       # number of trees in Random Forest\nRANDOM_SEED = 42\n\nMAX_SPAN    = 88.0      # reject polygons wider/taller than this (units) — matches your data scale\nMAX_EDGE    = 100.0     # reject polygons with any single edge longer than this (units)\n\n# 15 visually distinct colors ordered by class count rank (most common first)\n_PALETTE = [\n    \"#1F77B4\", \"#FF7F0E\", \"#2CA02C\", \"#D62728\", \"#9467BD\",\n    \"#8C564B\", \"#E377C2\", \"#17BECF\", \"#BCBD22\", \"#F5CB5C\",\n    \"#AEC7E8\", \"#FF9896\", \"#98DF8A\", \"#C5B0D5\", \"#C49C94\",\n]\n\n\n# =============================================================\n# STEP 1 — Load, clean, polygon QC, shape features, export CSVs\n# =============================================================\nprint(\"STEP 1 — Load + Clean + Polygon QC\")\n\ndf = pd.read_csv(DATA_PATH, low_memory=False)\nprint(f\"Loaded: {df.shape[0]:,} rows × {df.shape[1]} columns\")\n\n# Drop redundant ID, duplicate rows, all-zero and all-NaN columns\ndf.drop(columns=[\"feature_uID\"], errors=\"ignore\", inplace=True)\ndf.drop_duplicates(inplace=True)\nnum_cols  = df.select_dtypes(include=[np.number]).columns\nzero_cols = [c for c in num_cols if df[c].notna().any() and df[c].dropna().eq(0).all()]\nnan_cols  = [c for c in df.columns if df[c].isna().all()]\ndf.drop(columns=zero_cols + nan_cols, inplace=True)\nprint(f\"Dropped zero cols: {zero_cols} | NaN cols: {nan_cols}\")\nprint(f\"Shape after cleaning: {df.shape}\")\n\n# Extracts numeric values from a boundary string or array into a float numpy array\n_num_re = re.compile(r\"[-+]?\\d*\\.?\\d+(?:[eE][-+]?\\d+)?\")\ndef parse_coords(v):\n    if isinstance(v, (list, tuple, np.ndarray)):\n        a = np.asarray(v, dtype=np.float64)\n        return a if a.size else None\n    if pd.isna(v):\n        return None\n    nums = _num_re.findall(str(v))\n    return np.asarray(nums, dtype=np.float64) if nums else None\n\n# Validates a polygon: parses, removes duplicates, checks geometry thresholds\ndef validate_polygon(bx, by):\n    x, y = parse_coords(bx), parse_coords(by)\n    if x is None or y is None or len(x) != len(y) or len(x) < 3:\n        return None, None, False\n    m = np.isfinite(x) & np.isfinite(y)\n    x, y = x[m], y[m]\n    if len(x) < 3:\n        return None, None, False\n    keep = np.r_[True, ~(np.isclose(x[1:], x[:-1]) & np.isclose(y[1:], y[:-1]))]\n    x, y = x[keep], y[keep]\n    if len(x) < 3:\n        return None, None, False\n    if np.isclose(x[0], x[-1]) and np.isclose(y[0], y[-1]):\n        x, y = x[:-1], y[:-1]\n    if len(x) < 3:\n        return None, None, False\n    area      = 0.5 * abs(np.dot(x, np.roll(y, -1)) - np.dot(y, np.roll(x, -1)))\n    dx        = np.diff(np.r_[x, x[0]])\n    dy        = np.diff(np.r_[y, y[0]])\n    edges     = np.sqrt(dx**2 + dy**2)\n    perimeter = edges.sum()\n    if not (np.isfinite(area) and np.isfinite(perimeter)):\n        return None, None, False\n    if area <= 0 or perimeter <= 0:\n        return None, None, False\n    if (x.max() - x.min()) > MAX_SPAN or (y.max() - y.min()) > MAX_SPAN:\n        return None, None, False\n    if edges.max() > MAX_EDGE:\n        return None, None, False\n    return x, y, True\n\n# Computes area, perimeter, and circularity from a clean validated polygon\ndef shape_features(x, y):\n    area      = 0.5 * abs(np.dot(x, np.roll(y, -1)) - np.dot(y, np.roll(x, -1)))\n    dx        = np.diff(np.r_[x, x[0]])\n    dy        = np.diff(np.r_[y, y[0]])\n    perimeter = np.sqrt(dx**2 + dy**2).sum()\n    circ      = 4.0 * np.pi * area / perimeter**2 if perimeter > 0 else np.nan\n    return area, perimeter, circ\n\n# Run polygon QC on every row — fills poly_x, poly_y, is_good_poly, and shape features\npoly_x, poly_y, poly_ok = [], [], []\nfeats = np.full((len(df), 3), np.nan, dtype=np.float32)\nfor i, (bx, by) in enumerate(tqdm(\n    zip(df[\"boundaryX\"].values, df[\"boundaryY\"].values),\n    total=len(df), desc=\"Polygon QC\"\n)):\n    x, y, ok = validate_polygon(bx, by)\n    poly_x.append(x); poly_y.append(y); poly_ok.append(ok)\n    if ok:\n        feats[i] = shape_features(x, y)\n\ndf[SHAPE_COLS]     = feats\ndf[\"poly_x\"]       = poly_x\ndf[\"poly_y\"]       = poly_y\ndf[\"is_good_poly\"] = poly_ok\nprint(f\"Valid polygons: {sum(poly_ok):,} | Invalid: {sum(not v for v in poly_ok):,}\")\n\n# Export 3 aligned ML-ready CSVs: shape only, genes only, shape+genes\ndf_ml = df[df[\"is_good_poly\"]].copy()\ndf_ml.drop(columns=[\"boundaryX\", \"boundaryY\", \"poly_x\", \"poly_y\", \"is_good_poly\"],\n           inplace=True, errors=\"ignore\")\n\nn_classes = df_ml[LABEL_COL].nunique()\nprint(f\"Classes found: {n_classes}\")\nif n_classes != 15:\n    raise ValueError(f\"Expected 15 classes, got {n_classes}\")\n\nnum_cols   = df_ml.select_dtypes(include=[np.number]).columns.tolist()\ngene_cols  = [c for c in num_cols if c not in META_COLS and c not in SHAPE_COLS]\nid_present = [c for c in ID_COLS if c in df_ml.columns]\n\npaths = {\n    \"shape\": f\"{OUT_DIR}/model1_shape_only.csv\",\n    \"genes\": f\"{OUT_DIR}/model2_genes_only.csv\",\n    \"both\" : f\"{OUT_DIR}/model3_shape_plus_genes.csv\",\n}\ndf_ml[id_present + [LABEL_COL] + SHAPE_COLS].to_csv(paths[\"shape\"], index=False)\ndf_ml[id_present + [LABEL_COL] + gene_cols ].to_csv(paths[\"genes\"], index=False)\ndf_ml[id_present + [LABEL_COL] + SHAPE_COLS + gene_cols].to_csv(paths[\"both\"], index=False)\nprint(f\"Gene columns: {len(gene_cols)} | Rows kept: {len(df_ml):,}\")\n\n\n# =============================================================\n# STEP 2 — Plot validated boundary polygons per Bregma slice\n# =============================================================\nprint(\"\\nSTEP 2 — Plotting boundaries\")\n\nplot_df = (\n    df.dropna(subset=[\"Bregma\", LABEL_COL])\n      .loc[df[\"is_good_poly\"]]\n      .copy()\n)\nplot_df[LABEL_COL] = plot_df[LABEL_COL].astype(str)\n\n# Build color dictionary: each class gets a fixed distinct color by count rank\ncounts      = plot_df[LABEL_COL].value_counts()\nclasses     = counts.index.tolist()\ncolor_dict  = {cls: _PALETTE[i] for i, cls in enumerate(classes)}\nbregma_vals = sorted(plot_df[\"Bregma\"].unique())\nprint(f\"Valid cells for plotting: {len(plot_df):,}\")\n\n# Part A: 3×4 overview grid — one subplot per Bregma slice\nfig, axes = plt.subplots(3, 4, figsize=(28, 21))\naxes = axes.flatten()\nfor idx, bv in enumerate(tqdm(bregma_vals, desc=\"Overview grid\")):\n    ax     = axes[idx]\n    slice_ = plot_df[plot_df[\"Bregma\"] == bv]\n    for _, row in slice_.iterrows():\n        bx, by = row[\"poly_x\"], row[\"poly_y\"]\n        if bx is not None and len(bx) >= 3:\n            ax.fill(bx, by, color=color_dict[row[LABEL_COL]],\n                    edgecolor=\"black\", linewidth=0.2, alpha=0.7)\n    ax.set_title(f\"Bregma {bv} ({len(slice_)} cells)\", fontsize=11)\n    ax.set_aspect(\"equal\")\n    ax.set_xlabel(\"X\", fontsize=8)\n    ax.set_ylabel(\"Y\", fontsize=8)\nfor j in range(len(bregma_vals), len(axes)):\n    axes[j].axis(\"off\")\nlegend_handles = [\n    mpatches.Patch(color=color_dict[c], label=f\"{c} (n={counts[c]})\")\n    for c in counts.sort_values(ascending=False).index\n]\nfig.legend(handles=legend_handles, loc=\"center right\", bbox_to_anchor=(1.10, 0.5),\n           fontsize=9, title=f\"Cell classes\\nTotal = {len(plot_df):,}\", title_fontsize=10)\nfig.suptitle(f\"Cell Boundaries — All Bregma Slices (n={len(plot_df):,})\", fontsize=16, y=1.01)\nplt.tight_layout()\nplt.savefig(f\"{OUT_DIR}/plot_overview_3x4.png\", dpi=300, bbox_inches=\"tight\")\nplt.show()\n\n# Part B: one high-resolution zoomed plot per Bregma slice\nzoom_dir = f\"{OUT_DIR}/bregma_zoom_plots\"\nos.makedirs(zoom_dir, exist_ok=True)\nfor bv in tqdm(bregma_vals, desc=\"Zoomed plots\"):\n    slice_ = plot_df[plot_df[\"Bregma\"] == bv]\n    if slice_.empty:\n        continue\n    local_counts = slice_[LABEL_COL].value_counts()\n    fig, ax = plt.subplots(figsize=(18, 16), dpi=220)\n    for _, row in slice_.iterrows():\n        bx, by = row[\"poly_x\"], row[\"poly_y\"]\n        if bx is not None and len(bx) >= 3:\n            ax.fill(bx, by, facecolor=color_dict[row[LABEL_COL]],\n                    edgecolor=\"black\", linewidth=0.35, alpha=0.85)\n    all_x = np.concatenate([r for r in slice_[\"poly_x\"] if r is not None and len(r)])\n    all_y = np.concatenate([r for r in slice_[\"poly_y\"] if r is not None and len(r)])\n    fm    = np.isfinite(all_x) & np.isfinite(all_y)\n    all_x, all_y = all_x[fm], all_y[fm]\n    if len(all_x) == 0:\n        plt.close(fig); continue\n    xpad = max((all_x.max() - all_x.min()) * 0.01, 0.5)\n    ypad = max((all_y.max() - all_y.min()) * 0.01, 0.5)\n    ax.set_xlim(all_x.min() - xpad, all_x.max() + xpad)\n    ax.set_ylim(all_y.min() - ypad, all_y.max() + ypad)\n    ax.set_aspect(\"equal\")\n    ax.set_title(f\"Bregma {bv} — {len(slice_):,} valid cells\")\n    handles = [\n        mpatches.Patch(color=color_dict[c], label=f\"{c} — {local_counts[c]}\")\n        for c in local_counts.sort_values(ascending=False).index\n    ]\n    ax.legend(handles=handles, loc=\"center left\", bbox_to_anchor=(1.02, 0.5),\n              fontsize=9, title=f\"Bregma {bv}\", title_fontsize=10)\n    plt.tight_layout()\n    plt.savefig(os.path.join(zoom_dir, f\"bregma_{bv}_zoom.png\"), dpi=500, bbox_inches=\"tight\")\n    plt.show()\n\n\n# =============================================================\n# STEP 3 — Filter classes, balance, and build train/test split\n# =============================================================\nprint(\"\\nSTEP 3 — Preparing data for training\")\n\n# Load the 3 aligned CSVs saved in Step 1\ndf_shape = pd.read_csv(paths[\"shape\"])\ndf_genes = pd.read_csv(paths[\"genes\"])\ndf_both  = pd.read_csv(paths[\"both\"])\n\n# Verify all 3 datasets have the same rows in the same order\nif \"Cell_ID\" in df_shape.columns:\n    if not (df_shape[\"Cell_ID\"].tolist() == df_genes[\"Cell_ID\"].tolist() ==\n            df_both[\"Cell_ID\"].tolist()):\n        raise ValueError(\"Row mismatch across datasets — rebuild Step 1 outputs.\")\n\n# Show full class distribution before any filtering\nclass_counts = df_shape[LABEL_COL].value_counts()\nprint(\"\\nClass counts (post invalid-shape drop):\")\nprint(class_counts.to_string())\n\n# Keep only the top-K most common classes, applied to all 3 datasets equally\nkeep_classes = class_counts.head(TOP_K).index.tolist()\nmask = df_shape[LABEL_COL].isin(keep_classes).values\ndf_shape = df_shape.iloc[mask].reset_index(drop=True)\ndf_genes = df_genes.iloc[mask].reset_index(drop=True)\ndf_both  = df_both.iloc[mask].reset_index(drop=True)\nprint(f\"\\nCounts in kept subset (before balance):\")\nprint(df_shape[LABEL_COL].value_counts().to_string())\n\n# Downsample all classes to the smallest class count (only when BALANCE=True)\nif BALANCE:\n    min_n = int(df_shape[LABEL_COL].value_counts().min())\n    if min_n < 2:\n        raise ValueError(f\"Cannot balance: smallest class has only {min_n} rows.\")\n    keep_idx = (\n        df_shape.groupby(LABEL_COL, group_keys=False, sort=True)\n                .apply(lambda x: x.sample(n=min_n, random_state=RANDOM_SEED))\n                .index\n    )\n    keep_idx = np.sort(keep_idx.to_numpy())\n    df_shape = df_shape.loc[keep_idx].reset_index(drop=True)\n    df_genes = df_genes.loc[keep_idx].reset_index(drop=True)\n    df_both  = df_both.loc[keep_idx].reset_index(drop=True)\n    print(f\"\\nBalanced — {min_n} rows per class:\")\n    print(df_shape[LABEL_COL].value_counts().to_string())\n\n# Splits each class into train/test with exactly round(n * test_frac) test rows\ndef class_wise_split(df_ref, label_col=LABEL_COL, test_frac=TEST_FRAC, seed=RANDOM_SEED):\n    rng = np.random.RandomState(seed)\n    train_idx, test_idx = [], []\n    for _, g in df_ref.groupby(label_col, sort=False):\n        idx    = g.index.to_numpy()\n        n_test = max(1, round(len(idx) * test_frac))\n        if n_test >= len(idx):\n            raise ValueError(f\"Class too small to split: {len(idx)} rows\")\n        chosen = rng.choice(idx, size=n_test, replace=False)\n        test_idx.append(np.sort(chosen))\n        train_idx.append(np.setdiff1d(idx, chosen))\n    return np.sort(np.concatenate(train_idx)), np.sort(np.concatenate(test_idx))\n\ntrain_idx, test_idx = class_wise_split(df_shape)\nlabels_sorted = sorted(df_shape[LABEL_COL].astype(str).unique())\nprint(f\"\\nTrain size: {len(train_idx):,} | Test size: {len(test_idx):,}\")\n\n\n# =============================================================\n# STEP 4 — Train & evaluate 3 Random Forest models\n# =============================================================\nprint(\"\\nSTEP 4 — Training models\")\n\n# Trains a Random Forest pipeline, prints metrics, and shows a confusion matrix\ndef train_and_eval(df_in, name):\n    drop  = [LABEL_COL] + [c for c in ID_COLS if c in df_in.columns]\n    X     = df_in.drop(columns=drop)\n    y     = df_in[LABEL_COL].astype(str)\n    X_tr, X_te = X.iloc[train_idx], X.iloc[test_idx]\n    y_tr, y_te = y.iloc[train_idx], y.iloc[test_idx]\n    model = Pipeline([\n        (\"imputer\", SimpleImputer(strategy=\"median\")),\n        (\"rf\", RandomForestClassifier(\n            n_estimators=N_TREES, random_state=RANDOM_SEED,\n            n_jobs=-1, class_weight=\"balanced\"\n        ))\n    ])\n    model.fit(X_tr, y_tr)\n    y_pred = model.predict(X_te)\n    metrics = {\n        \"accuracy\"        : accuracy_score(y_te, y_pred),\n        \"macro_f1\"        : f1_score(y_te, y_pred, average=\"macro\"),\n        \"macro_precision\" : precision_score(y_te, y_pred, average=\"macro\", zero_division=0),\n        \"macro_recall\"    : recall_score(y_te, y_pred, average=\"macro\", zero_division=0),\n    }\n    print(f\"\\n{name}\")\n    for k, v in metrics.items():\n        print(f\"  {k:<20}: {v:.4f}\")\n    fig, ax = plt.subplots(figsize=(10, 10))\n    ConfusionMatrixDisplay.from_predictions(\n        y_te, y_pred, labels=labels_sorted, xticks_rotation=90, ax=ax\n    )\n    ax.set_title(f\"Confusion Matrix — {name}\")\n    plt.tight_layout()\n    plt.show()\n    return {**metrics, \"model\": model}\n\nres_shape = train_and_eval(df_shape, \"Model 1 — Shape Only\")\nres_genes = train_and_eval(df_genes, \"Model 2 — Genes Only\")\nres_both  = train_and_eval(df_both,  \"Model 3 — Shape + Genes\")\n\n# Save all 3 model metrics to a single summary CSV\nsummary = pd.DataFrame([\n    {\"model\": \"shape_only\",       **{k: v for k, v in res_shape.items() if k != \"model\"}},\n    {\"model\": \"genes_only\",       **{k: v for k, v in res_genes.items() if k != \"model\"}},\n    {\"model\": \"shape_plus_genes\", **{k: v for k, v in res_both.items()  if k != \"model\"}},\n])\nsummary.to_csv(f\"{OUT_DIR}/rf_metrics_summary.csv\", index=False)\n\n# Print a clean formatted metrics table\nprint(\"\\n\" + \"=\"*62)\nprint(f\"{'MODEL':<20} {'ACCURACY':>9} {'MACRO-F1':>9} {'MACRO-PREC':>11} {'MACRO-REC':>10}\")\nprint(\"-\"*62)\nfor _, r in summary.iterrows():\n    print(f\"{r['model']:<20} {r['accuracy']:>9.4f} {r['macro_f1']:>9.4f} \"\n          f\"{r['macro_precision']:>10.4f} {r['macro_recall']:>8.4f}\")\nprint(\"=\"*62)\n\n# Bar chart comparing all 4 metrics across the 3 models\nmetrics_to_plot = [\"accuracy\", \"macro_f1\", \"macro_precision\", \"macro_recall\"]\nmodel_labels    = [\"Shape Only\", \"Genes Only\", \"Shape + Genes\"]\nx = np.arange(len(metrics_to_plot))\nwidth = 0.25\ncolors = [\"#1F77B4\", \"#FF7F0E\", \"#2CA02C\"]\n\nfig, ax = plt.subplots(figsize=(10, 5))\nfor i, (_, r) in enumerate(summary.iterrows()):\n    vals = [r[m] for m in metrics_to_plot]\n    bars = ax.bar(x + i * width, vals, width, label=model_labels[i], color=colors[i], alpha=0.85)\n    # Add value labels on top of each bar\n    for bar, v in zip(bars, vals):\n        ax.text(bar.get_x() + bar.get_width() / 2, bar.get_height() + 0.01,\n                f\"{v:.3f}\", ha=\"center\", va=\"bottom\", fontsize=8)\n\nax.set_xticks(x + width)\nax.set_xticklabels([\"Accuracy\", \"Macro-F1\", \"Macro-Precision\", \"Macro-Recall\"], fontsize=11)\nax.set_ylim(0, 1.12)\nax.set_ylabel(\"Score\", fontsize=11)\nax.set_title(f\"RF Model Comparison  |  TOP_K={TOP_K}  BALANCE={BALANCE}\", fontsize=12)\nax.legend(fontsize=10)\nax.axhline(y=1.0, color=\"gray\", linewidth=0.5, linestyle=\"--\")\nplt.tight_layout()\nplt.savefig(f\"{OUT_DIR}/rf_metrics_comparison.png\", dpi=200, bbox_inches=\"tight\")\nplt.show()\nprint(\"Saved: rf_metrics_comparison.png\")\n\n\n# =============================================================\n# STEP 5 — Interactive single-cell prediction\n# =============================================================\nprint(\"\\nSTEP 5 — Interactive prediction ready\")\n\n# Predicts the class of any test cell using all 3 models and shows top-3 probabilities\n# NOTE: valid sample_idx range is always printed in STEP 3 as \"Test size\"\ndef predict_cell(sample_idx=0):\n    if not (0 <= sample_idx < len(test_idx)):\n        raise IndexError(\n            f\"sample_idx must be 0–{len(test_idx)-1}  \"\n            f\"(test size changes when BALANCE or TOP_K change)\"\n        )\n    row_idx    = test_idx[sample_idx]\n    true_label = df_shape[LABEL_COL].astype(str).iloc[row_idx]\n    print(f\"\\n{'='*50}\")\n    print(f\"Test cell #{sample_idx}  (dataset row {row_idx})\")\n    print(f\"True label : {true_label}\")\n    if \"Cell_ID\" in df_shape.columns:\n        print(f\"Cell_ID    : {df_shape.iloc[row_idx]['Cell_ID']}\")\n    print(\"=\" * 50)\n    for name, df_in, res in [\n        (\"Shape Only\",    df_shape, res_shape),\n        (\"Genes Only\",    df_genes, res_genes),\n        (\"Shape + Genes\", df_both,  res_both),\n    ]:\n        drop  = [LABEL_COL] + [c for c in ID_COLS if c in df_in.columns]\n        X     = df_in.drop(columns=drop)\n        row   = X.iloc[[row_idx]]\n        pred  = res[\"model\"].predict(row)[0]\n        proba = res[\"model\"].predict_proba(row)[0]\n        top3  = sorted(zip(res[\"model\"].classes_, proba), key=lambda x: -x[1])[:3]\n        top3  = [(c, round(p, 3)) for c, p in top3]\n        status = \"✓\" if pred == true_label else \"✗\"\n        print(f\"\\n[{name}]  {status} Predicted: {pred}\")\n        print(f\"  Top-3: {top3}\")\n\n# Change sample_idx to any value between 0 and the test size printed in STEP 3\npredict_cell(sample_idx=0)\n\n\n# =============================================================\n# STEP 6 — CNN on rasterized cell shapes (TensorFlow/Keras)\n# =============================================================\nprint(\"\\nSTEP 6 — CNN Shape Classifier (TensorFlow/Keras)\")\n\nimport tensorflow as tf\nfrom tensorflow import keras\nfrom tensorflow.keras import layers\nfrom skimage.draw import polygon as sk_polygon\n\n# CNN config — adjust here if needed\nIMG_SIZE   = 64    # each cell polygon is rasterized into IMG_SIZE × IMG_SIZE\nCNN_EPOCHS = 10\nCNN_LR     = 1e-4  # lower LR for stable training with BatchNorm\nCNN_BATCH  = 64\nprint(f\"GPU available: {len(tf.config.list_physical_devices('GPU')) > 0}\")\n\n# Build label encoder from the same classes used in RF (labels_sorted)\nclass_to_idx  = {c: i for i, c in enumerate(labels_sorted)}\nidx_to_class  = {i: c for c, i in class_to_idx.items()}\nn_cnn_classes = len(class_to_idx)\n\n# Rasterizes a single polygon into a binary IMG_SIZE×IMG_SIZE image\ndef rasterize_polygon(px, py, size=IMG_SIZE):\n    img = np.zeros((size, size), dtype=np.float32)\n    x = px - px.min(); y = py - py.min()\n    scale = (size - 4) / max(x.max(), y.max(), 1e-6)\n    x = (x * scale + 2).astype(np.float64)\n    y = (y * scale + 2).astype(np.float64)\n    rr, cc = sk_polygon(y, x, shape=(size, size))\n    img[rr, cc] = 1.0\n    return img\n\n# Rebuild polygon lookup from main df using Cell_ID as key\nprint(\"Rasterizing polygons...\")\npoly_lookup = {}\nif \"Cell_ID\" in df.columns:\n    for _, row in df[df[\"is_good_poly\"]].iterrows():\n        poly_lookup[row[\"Cell_ID\"]] = (row[\"poly_x\"], row[\"poly_y\"])\n\n# Build images and labels aligned to df_shape row order\nimages, cnn_labels = [], []\nskipped = 0\nfor _, row in tqdm(df_shape.iterrows(), total=len(df_shape), desc=\"Rasterizing\"):\n    label   = str(row[LABEL_COL])\n    if label not in class_to_idx:\n        skipped += 1; continue\n    cell_id = row.get(\"Cell_ID\", None)\n    px, py  = poly_lookup.get(cell_id, (None, None)) if cell_id else (None, None)\n    if px is None or len(px) < 3:\n        skipped += 1; continue\n    images.append(rasterize_polygon(px, py))\n    cnn_labels.append(class_to_idx[label])\n\nprint(f\"Rasterized: {len(images):,} cells | Skipped: {skipped}\")\n\n# CRITICAL check — images must align exactly with df_shape rows\n# If not equal, train/test indices will point to wrong cells\nprint(f\"df_shape rows : {len(df_shape)}\")\nprint(f\"Images built  : {len(images)}\")\nif len(images) != len(df_shape):\n    raise ValueError(\n        f\"Alignment broken: df_shape has {len(df_shape)} rows \"\n        f\"but only {len(images)} images were built. \"\n        f\"Skipped {skipped} rows — check poly_lookup.\"\n    )\n\n# Shape: (N, 64, 64, 1) — TensorFlow uses channels-last format\nimages     = np.array(images, dtype=np.float32)[..., np.newaxis]\ncnn_labels = np.array(cnn_labels, dtype=np.int32)\n\n# =============================================================\n# STEP 6a — Verify rasterization before training\n# Run this and check all 4 checks pass before proceeding\n# =============================================================\nprint(\"\\nSTEP 6a — Verification\")\n\n# Check 1: label-image alignment for 3 rows\nprint(\"\\nCheck 1 — Label alignment:\")\nprint(f\"{'Row':<6} {'Cell_ID':<38} {'True Label':<20} {'CNN Label':<20} {'Pixels':>7} {'OK?'}\")\nprint(\"-\" * 100)\nfor i in [0, 100, 500]:\n    cell_id    = df_shape.iloc[i][\"Cell_ID\"] if \"Cell_ID\" in df_shape.columns else \"N/A\"\n    true_label = df_shape.iloc[i][LABEL_COL]\n    cnn_label  = idx_to_class[cnn_labels[i]]\n    pixels     = images[i].sum()\n    match      = \"✓\" if true_label == cnn_label else \"✗ MISMATCH!\"\n    print(f\"{i:<6} {str(cell_id):<38} {true_label:<20} {cnn_label:<20} {pixels:>7.0f} {match}\")\nprint(\"-\" * 100)\n\n# Check 1b — show all 3 rows as images with Cell_ID for visual verification\nfig, axes = plt.subplots(1, 3, figsize=(12, 4))\nfor ax, i in zip(axes, [0, 100, 500]):\n    img     = images[i, :, :, 0]\n    label   = df_shape.iloc[i][LABEL_COL]\n    cell_id = df_shape.iloc[i][\"Cell_ID\"] if \"Cell_ID\" in df_shape.columns else \"N/A\"\n    ax.imshow(img, cmap=\"gray\")\n    ax.set_title(f\"Row {i} — {label}\\nID: {str(cell_id)[:20]}\\npixels={img.sum():.0f}\", fontsize=8)\n    ax.axis(\"off\")\nplt.suptitle(\"Check 1b — visual proof: cell shape, label and pixel count\", fontsize=11)\nplt.tight_layout()\nplt.show()\n\n# Check 2: pixel statistics across all images\npx_sums = images.reshape(len(images), -1).sum(axis=1)\nprint(f\"\\nCheck 2 — Pixel stats: min={px_sums.min():.0f} max={px_sums.max():.0f} mean={px_sums.mean():.1f}\")\nprint(f\"  Empty images (0 pixels): {(px_sums == 0).sum()} — must be 0\")\n\n# Check 3: class counts match — sorted most common to rarest\nprint(f\"\\nCheck 3 — Class counts match (sorted by count):\")\nall_match = True\nsorted_classes = df_shape[LABEL_COL].value_counts().index.tolist()\nfor cls in sorted_classes:\n    n_df  = (df_shape[LABEL_COL] == cls).sum()\n    n_img = (cnn_labels == class_to_idx[cls]).sum()\n    ok    = \"✓\" if n_df == n_img else \"✗\"\n    if n_df != n_img: all_match = False\n    print(f\"  {cls:<20} df={n_df:>6}  img={n_img:>6}  {ok}\")\nprint(f\"  All match: {'✓' if all_match else '✗ PROBLEM FOUND'}\")\n\n# Check 4: visual — one sample image per class\nprint(\"\\nCheck 4 — Visual sample per class:\")\nfig, axes = plt.subplots(3, 5, figsize=(15, 9))\naxes = axes.flatten()\nfor i, cls in enumerate(labels_sorted):\n    cls_idx = class_to_idx[cls]\n    matches = np.where(cnn_labels == cls_idx)[0]\n    if len(matches) == 0:\n        axes[i].axis(\"off\"); continue\n    img = images[matches[0], :, :, 0]\n    axes[i].imshow(img, cmap=\"gray\")\n    axes[i].set_title(f\"{cls}\\npx={img.sum():.0f}\", fontsize=8)\n    axes[i].axis(\"off\")\nfor j in range(len(labels_sorted), len(axes)):\n    axes[j].axis(\"off\")\nplt.suptitle(\"One sample cell image per class — white shape on black = correct\", fontsize=11)\nplt.tight_layout()\nplt.show()\nprint(\"If all 4 checks pass → proceed to Step 6b\\n\")\n\n# =============================================================\n# STEP 6b — Train the CNN\n# =============================================================\nprint(\"STEP 6b — Training CNN\")\n\n# Split using the same train/test indices as RF for a fair comparison\nX_train, X_test = images[train_idx], images[test_idx]\ny_train, y_test = cnn_labels[train_idx], cnn_labels[test_idx]\n\n# Build CNN with BatchNormalization for training stability\n# BatchNorm normalizes each layer's output — prevents loss from getting stuck\ndef build_cnn(n_classes, img_size=IMG_SIZE):\n    model = keras.Sequential([\n        # Block 1: 1→32 filters, 64×64 → 32×32\n        layers.Conv2D(32, 3, padding=\"same\", input_shape=(img_size, img_size, 1)),\n        layers.BatchNormalization(), layers.Activation(\"relu\"),\n        layers.Conv2D(32, 3, padding=\"same\"),\n        layers.BatchNormalization(), layers.Activation(\"relu\"),\n        layers.MaxPooling2D(2),\n        # Block 2: 32→64 filters, 32×32 → 16×16\n        layers.Conv2D(64, 3, padding=\"same\"),\n        layers.BatchNormalization(), layers.Activation(\"relu\"),\n        layers.Conv2D(64, 3, padding=\"same\"),\n        layers.BatchNormalization(), layers.Activation(\"relu\"),\n        layers.MaxPooling2D(2),\n        # Block 3: 64→128 filters, 16×16 → 8×8\n        layers.Conv2D(128, 3, padding=\"same\"),\n        layers.BatchNormalization(), layers.Activation(\"relu\"),\n        layers.MaxPooling2D(2),\n        # Classifier head\n        layers.Flatten(),\n        layers.Dense(256), layers.BatchNormalization(), layers.Activation(\"relu\"),\n        layers.Dropout(0.3),\n        layers.Dense(n_classes, activation=\"softmax\"),\n    ])\n    return model\n\nmodel_cnn = build_cnn(n_cnn_classes)\nmodel_cnn.compile(\n    optimizer=keras.optimizers.Adam(CNN_LR),\n    loss=\"sparse_categorical_crossentropy\",\n    metrics=[\"accuracy\"]\n)\nmodel_cnn.summary()\n\n# Train WITHOUT class_weight — imbalance already handled by RF-style evaluation\n# class_weight was causing loss collapse in previous run\nprint(f\"\\nTraining CNN for {CNN_EPOCHS} epochs...\")\nhistory = model_cnn.fit(\n    X_train, y_train,\n    epochs=CNN_EPOCHS,\n    batch_size=CNN_BATCH,\n    validation_data=(X_test, y_test),\n    verbose=1\n)\n\n# Plot training history — loss and accuracy per epoch\nfig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 4))\nax1.plot(history.history[\"loss\"],     label=\"Train loss\")\nax1.plot(history.history[\"val_loss\"], label=\"Val loss\")\nax1.set_title(\"Loss per epoch\"); ax1.legend()\nax2.plot(history.history[\"accuracy\"],     label=\"Train acc\")\nax2.plot(history.history[\"val_accuracy\"], label=\"Val acc\")\nax2.set_title(\"Accuracy per epoch\"); ax2.legend()\nplt.tight_layout(); plt.show()\n\n# Evaluate on test set and compute all metrics\ny_pred_proba = model_cnn.predict(X_test, verbose=0)\ny_pred       = y_pred_proba.argmax(axis=1)\npred_names   = [idx_to_class[p] for p in y_pred]\ntrue_names   = [idx_to_class[t] for t in y_test]\n\ncnn_metrics = {\n    \"accuracy\"        : accuracy_score(true_names, pred_names),\n    \"macro_f1\"        : f1_score(true_names, pred_names, average=\"macro\", zero_division=0),\n    \"macro_precision\" : precision_score(true_names, pred_names, average=\"macro\", zero_division=0),\n    \"macro_recall\"    : recall_score(true_names, pred_names, average=\"macro\", zero_division=0),\n}\nprint(f\"\\nCNN — Shape Only (64×64 rasterized polygons)\")\nfor k, v in cnn_metrics.items():\n    print(f\"  {k:<20}: {v:.4f}\")\n\n# Confusion matrix for CNN\nfig, ax = plt.subplots(figsize=(10, 10))\nConfusionMatrixDisplay.from_predictions(\n    true_names, pred_names, labels=labels_sorted, xticks_rotation=90, ax=ax\n)\nax.set_title(\"Confusion Matrix — CNN Shape Only\")\nplt.tight_layout(); plt.show()\n\n# Final comparison table: RF Shape vs CNN Shape\nprint(\"\\n\" + \"=\"*62)\nprint(\"RF vs CNN — Shape Only Comparison\")\nprint(\"-\"*62)\nprint(f\"{'MODEL':<25} {'ACCURACY':>9} {'MACRO-F1':>9}\")\nprint(\"-\"*62)\nprint(f\"{'RF  — Shape Only':<25} {res_shape['accuracy']:>9.4f} {res_shape['macro_f1']:>9.4f}\")\nprint(f\"{'CNN — Shape Only':<25} {cnn_metrics['accuracy']:>9.4f} {cnn_metrics['macro_f1']:>9.4f}\")\nprint(\"=\"*62)","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-04-05T20:43:32.363318Z","iopub.execute_input":"2026-04-05T20:43:32.363651Z","iopub.status.idle":"2026-04-05T20:44:05.902452Z","shell.execute_reply.started":"2026-04-05T20:43:32.363622Z","shell.execute_reply":"2026-04-05T20:44:05.901103Z"}},"outputs":[{"name":"stdout","text":"STEP 1 — Load + Clean + Polygon QC\nLoaded: 32,648 rows × 168 columns\nDropped zero cols: [] | NaN cols: ['Fos']\nShape after cleaning: (32648, 166)\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"Polygon QC:   0%|          | 0/32648 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"91261da441184ad6a87e71d104491d6a"}},"metadata":{}},{"name":"stdout","text":"Valid polygons: 32,019 | Invalid: 629\nClasses found: 15\nGene columns: 155 | Rows kept: 32,019\n\nSTEP 2 — Plotting boundaries\nValid cells for plotting: 32,019\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"Overview grid:   0%|          | 0/12 [00:00<?, ?it/s]","a