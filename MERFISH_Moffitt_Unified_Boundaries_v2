    "# PHASE 5 — STEP 2\n",
    "# Plot a gene’s spatial profile across Cell_classes:\n",
    "# bars = mean radial_norm, colors = confidence by molecule count.\n",
    "\n",
    "def plot_gene_across_classes(gene_name):\n",
    "    sub = class_signatures[class_signatures[\"Gene_name\"] == gene_name]\n",
    "    if sub.empty:\n",
    "        print(f\"No data for gene: {gene_name}\")\n",
    "        return\n",
    "\n",
    "    sub = sub.sort_values(\"radial_mean\", ascending=False)\n",
    "\n",
    "    classes = sub[\"Cell_class\"].tolist()\n",
    "    means   = sub[\"radial_mean\"].tolist()\n",
    "    counts  = df[df[\"Gene_name\"] == gene_name].groupby(\"Cell_class\").size().reindex(classes).fillna(0).astype(int)\n",
    "\n",
    "    # confidence colors\n",
    "    colors = [\n",
    "        \"red\" if c < 20 else \"orange\" if c < 100 else \"steelblue\"\n",
    "        for c in counts\n",
    "    ]\n",
    "\n",
    "    plt.figure(figsize=(14,6))\n",
    "    bars = plt.bar(classes, means, color=colors, alpha=0.9)\n",
    "\n",
    "    for bar, count in zip(bars, counts):\n",
    "        plt.text(\n",
    "            bar.get_x() + bar.get_width()/2,\n",
    "            bar.get_height() + 0.02,\n",
    "            str(count),\n",
    "            ha=\"center\",\n",
    "            fontsize=10\n",
    "        )\n",
    "\n",
    "    plt.title(f\"{gene_name} — mean radial_norm across Cell_classes\", fontsize=14)\n",
    "    plt.xlabel(\"Cell_class\")\n",
    "    plt.ylabel(\"mean radial_norm (0=center, 1=membrane)\")\n",
    "    plt.xticks(rotation=45, ha=\"right\")\n",
    "    plt.ylim(0, 1.1)\n",
    "\n",
    "    from matplotlib.patches import Patch\n",
    "    legend_items = [\n",
    "        Patch(color=\"steelblue\", label=\"count > 100 (high confidence)\"),\n",
    "        Patch(color=\"orange\",    label=\"20–100 (medium confidence)\"),\n",
    "        Patch(color=\"red\",       label=\"count < 20 (low confidence)\")\n",
    "    ]\n",
    "    plt.legend(handles=legend_items, loc=\"upper right\")\n",
    "\n",
    "    explanation = (\n",
    "        \"Interpretation:\\n\"\n",
    "        \"- Bars sorted by mean radial_norm\\n\"\n",
    "        \"- Height = mean radial_norm (0=center, 1=membrane)\\n\"\n",
    "        \"- Number above bar = molecule count for this Cell_class\"\n",
    "    )\n",
    "\n",
    "    plt.text(\n",
    "        0.02, 0.98,\n",
    "        explanation,\n",
    "        transform=plt.gca().transAxes,\n",
    "        fontsize=9,\n",
    "        va=\"top\",\n",
    "        bbox=dict(boxstyle='round,pad=0.4', facecolor='white', alpha=0.70)\n",
    "    )\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "plot_gene_across_classes(\"Amigo2\")\n"
   ]
