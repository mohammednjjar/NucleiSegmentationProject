    "# PHASE 1\n",
    "# Load unified dataset, convert boundary strings → numeric lists,\n",
    "# and compute QC counts (no plotting here).\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from shapely.geometry import Point, Polygon\n",
    "from tqdm import tqdm\n",
    "\n",
    "# --- Load dataset ---\n",
    "df = pd.read_csv(\n",
    "    \"/kaggle/input/merfish-moffitt-boundaries-unified/MERFISH_Moffitt_Boundaries_UNIFIED.csv\"\n",
    ")\n",
    "\n",
    "# --- Parse boundary coordinate lists ---\n",
    "def parse_boundary(x):\n",
    "    if isinstance(x, list):\n",
    "        return x\n",
    "    if not isinstance(x, str):\n",
    "        return []\n",
    "    x = x.replace(\"[\",\"\").replace(\"]\",\"\").replace(\";\",\",\")\n",
    "    vals = []\n",
    "    for v in x.split(\",\"):\n",
    "        v = v.strip()\n",
    "        if v:\n",
    "            try:\n",
    "                vals.append(float(v))\n",
    "            except:\n",
    "                pass\n",
    "    return vals\n",
    "\n",
    "df[\"boundaryX\"] = df[\"boundaryX\"].apply(parse_boundary)\n",
    "df[\"boundaryY\"] = df[\"boundaryY\"].apply(parse_boundary)\n",
    "\n",
    "# --- QC: summary counts ---\n",
    "mol_counts = df.groupby(\"Cell_ID\").size()\n",
    "class_counts = df.groupby(\"Cell_class\").size().sort_values(ascending=False)\n",
    "\n",
    "class_counts.head(20)\n"
   ]
