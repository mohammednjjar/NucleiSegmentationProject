    "# PHASE 2 — STEP 1\n",
    "# Compute radial distance r = sqrt((x−cx)²+(y−cy)²) for each molecule actual distance from molecule → centroid, \n",
    "#then normalize by each cell’s max radius (r_norm = r / max(r_cell), 0=center → 1=membrane).\n",
    "\n",
    "df[\"radial_dist\"] = np.sqrt(\n",
    "    (df[\"Molecule_X\"] - df[\"Cell_Centroid_X\"])**2 +\n",
    "    (df[\"Molecule_Y\"] - df[\"Cell_Centroid_Y\"])**2\n",
    ")\n",
    "\n",
    "radial_stats = df.groupby(\"Cell_ID\")[\"radial_dist\"].agg(\n",
    "    [\"count\",\"mean\",\"median\",\"max\"]\n",
    ").reset_index()\n",
    "\n",
    "df[\"radial_norm\"] = df[\"radial_dist\"] / \\\n",
    "    df.groupby(\"Cell_ID\")[\"radial_dist\"].transform(\"max\")\n",
    "df[[\"radial_dist\", \"radial_norm\"]].head()\n"
   ]
