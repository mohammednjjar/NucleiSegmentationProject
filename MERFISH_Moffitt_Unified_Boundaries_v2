    "# PHASE 2 — STEP 5\n",
    "# Intracellular gene polarity via mean unit direction vectors\n",
    "# u_i = (x_i − cx, y_i − cy) / ||x_i − cx, y_i − cy||\n",
    "# p = mean(u_i), |p| ∈ [0,1]\n",
    "\n",
    "MIN_COUNT = 5\n",
    "pol_records = []\n",
    "\n",
    "for (cid, gene), sub in tqdm(\n",
    "    df.groupby([\"Cell_ID\", \"Gene_name\"]),\n",
    "    desc=\"Computing polarity\"\n",
    "):\n",
    "    # remove undefined directions (radial_dist == 0)\n",
    "    sub = sub[sub[\"radial_dist\"] > 0]\n",
    "\n",
    "    # enforce minimum molecule count\n",
    "    if len(sub) < MIN_COUNT:\n",
    "        continue\n",
    "\n",
    "    cx = sub[\"Cell_Centroid_X\"].iloc[0]\n",
    "    cy = sub[\"Cell_Centroid_Y\"].iloc[0]\n",
    "\n",
    "    dx = (sub[\"Molecule_X\"] - cx) / sub[\"radial_dist\"]\n",
    "    dy = (sub[\"Molecule_Y\"] - cy) / sub[\"radial_dist\"]\n",
    "\n",
    "    px = dx.mean()\n",
    "    py = dy.mean()\n",
    "    mag = np.sqrt(px**2 + py**2)\n",
    "\n",
    "    pol_records.append([cid, gene, px, py, mag, len(sub)])\n",
    "\n",
    "polarity_df = pd.DataFrame(\n",
    "    pol_records,\n",
    "    columns=[\n",
    "        \"Cell_ID\",\n",
    "        \"Gene_name\",\n",
    "        \"pol_x\",\n",
    "        \"pol_y\",\n",
    "        \"pol_magnitude\",\n",
    "        \"n_molecules\",\n",
    "    ],\n",
    ")\n",
    "\n",
    "# remove any old polarity columns before merging\n",
    "df = df.drop(\n",
    "    columns=[\"pol_x\", \"pol_y\", \"pol_magnitude\", \"n_molecules\"],\n",
    "    errors=\"ignore\"\n",
    ")\n",
    "\n",
    "# merge cleanly\n",
    "df = df.merge(polarity_df, on=[\"Cell_ID\", \"Gene_name\"], how=\"left\")\n",
    "\n",
    "# output check\n",
    "polarity_df.head()\n"
   ]
