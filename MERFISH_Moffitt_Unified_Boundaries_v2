    "# Heatmap of gene radial positioning across cell classes.\n",
    "# Values are z-scored per gene: (value − gene mean) / gene standard deviation.\n",
    "# Positive = more peripheral than the gene’s average; negative = more central.\n",
    "# Only genes present in all cell classes are shown for fair comparison.\n",
    "\n",
    "from scipy.stats import zscore\n",
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# pivot\n",
    "heat = class_signatures.pivot(\n",
    "    index=\"Cell_class\",\n",
    "    columns=\"Gene_name\",\n",
    "    values=\"radial_mean\"\n",
    ")\n",
    "\n",
    "# drop genes with NaNs (important)\n",
    "heat = heat.dropna(axis=1)\n",
    "\n",
    "# z-score per gene (column-wise)\n",
    "heat_z = heat.apply(zscore, axis=0)\n",
    "\n",
    "plt.figure(figsize=(20, 6))\n",
    "sns.heatmap(\n",
    "    heat_z,\n",
    "    cmap=\"vlag\",\n",
    "    center=0,\n",
    "    cbar=True\n",
    ")\n",
    "\n",
    "plt.xlabel(\"Gene\")\n",
    "plt.ylabel(\"Cell_class\")\n",
    "plt.title(\"All genes — z-scored radial positioning (Class × Gene)\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
