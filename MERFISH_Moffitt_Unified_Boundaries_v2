    "# PHASE 2 — STEP 3\n",
    "# Membrane Proximity Index (MPI)\n",
    "# Equation:\n",
    "#   MPI_i = 1 − ( d_mem,i / max(d_mem,cell) )\n",
    "# where:\n",
    "#   d_mem, i = Euclidean distance from molecule i to the cell membrane\n",
    "# Interpretation:\n",
    "#   MPI ∈ [0,1], higher values indicate molecules closer to the membrane\n",
    "\n",
    "df[\"MPI\"] = 1 - (\n",
    "    df[\"dist_to_membrane\"] /\n",
    "    df.groupby(\"Cell_ID\")[\"dist_to_membrane\"].transform(\"max\")\n",
    ")\n",
    "\n",
    "# Output check\n",
    "df[[\"Cell_ID\", \"dist_to_membrane\", \"MPI\"]].head()\n"
   ]
