    "# PHASE 2 — STEP 2\n",
    "# Distance molecule → membrane using Shapely.\n",
    "#   d_mem = polygon.exterior.distance(Point)\n",
    "\n",
    "cell_polygons = {\n",
    "    cid: Polygon(zip(sub[\"boundaryX\"].iloc[0], sub[\"boundaryY\"].iloc[0]))\n",
    "    for cid, sub in df.groupby(\"Cell_ID\")\n",
    "}\n",
    "\n",
    "df[\"dist_to_membrane\"] = np.nan\n",
    "\n",
    "for idx in tqdm(df.index, desc=\"Computing membrane distance\"):\n",
    "    row = df.loc[idx]\n",
    "    poly = cell_polygons[row[\"Cell_ID\"]]\n",
    "    df.at[idx, \"dist_to_membrane\"] = poly.exterior.distance(\n",
    "        Point(row[\"Molecule_X\"], row[\"Molecule_Y\"])\n",
    "    )\n",
    "df[[\"Cell_ID\", \"dist_to_membrane\"]].groupby(\"Cell_ID\").head(1).head()\n"
   ]
