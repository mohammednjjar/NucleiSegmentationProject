    "# PHASE 2 — STEP 4\n",
    "# Spatial entropy per cell based on radial distribution\n",
    "# H = - Σ p_k log(p_k), where Σ p_k = 1\n",
    "\n",
    "entropy_dict = {}\n",
    "BINS = 10\n",
    "\n",
    "for cid, sub in tqdm(df.groupby(\"Cell_ID\"), desc=\"Computing entropy\"):\n",
    "    vals = sub[\"radial_norm\"].values\n",
    "    hist, _ = np.histogram(vals, bins=BINS, range=(0,1), density=False)\n",
    "    p = hist / hist.sum()\n",
    "    p = p[p > 0]\n",
    "    H = -np.sum(p * np.log(p))\n",
    "    entropy_dict[cid] = H\n",
    "\n",
    "df[\"entropy\"] = df[\"Cell_ID\"].map(entropy_dict)\n",
    "df[[\"Cell_ID\", \"entropy\"]].drop_duplicates().head()\n"
   ]
