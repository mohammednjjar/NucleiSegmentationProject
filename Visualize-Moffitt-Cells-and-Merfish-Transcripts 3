-08-09T15:14:23.989672Z","shell.execute_reply.started":"2025-08-09T14:58:01.295039Z","shell.execute_reply":"2025-08-09T15:14:23.988643Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1500x1500 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":13},{"cell_type":"code","source":"# Cell 10  Spatial QC: For each molecule, test if its centroid lies within the assigned cell's polygon boundary.\n# Handles multiple boundary formats; stores result as True/False in 'molecule_inside'.\n\ndef safe_parse_list(val):\n    try:\n        # Try to parse as list string\n        if isinstance(val, str) and val.strip().startswith(\"[\"):\n            return ast.literal_eval(val)\n        # Try to parse as semicolon-separated numbers\n        return [float(x) for x in str(val).split(\";\")]\n    except Exception:\n        return []\n\ndef is_inside(row):\n    x = safe_parse_list(row['boundaryX'])\n    y = safe_parse_list(row['boundaryY'])\n    if len(x) < 3 or len(y) < 3 or len(x) != len(y):\n        return False\n    poly = Polygon(zip(x, y))\n    pt = Point(row['Centroid_X'], row['Centroid_Y'])\n    return poly.contains(pt)\n\ndf_merged['molecule_inside'] = df_merged.apply(is_inside, axis=1)\n\n# Summarize spatial QC results: total molecules, count/percentage inside boundaries, and count/percentage outside.\n\nn_total = len(df_merged)\nn_inside = df_merged['molecule_inside'].sum()\nn_outside = n_total - n_inside\npercent_inside = (n_inside / n_total) * 100\n\nprint(f\"Total molecules checked: {n_total}\")\nprint(f\"Molecules inside assigned cell: {n_inside} ({percent_inside:.2f}%)\")\nprint(f\"Molecules outside assigned cell: {n_outside} ({100 - percent_inside:.2f}%)\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-08-09T15:55:45.868003Z","iopub.execute_input":"2025-08-09T15:55:45.868648Z","iopub.status.idle":"2025-08-09T16:07:29.463603Z","shell.execute_reply.started":"2025-08-09T15:55:45.868625Z","shell.execute_repl