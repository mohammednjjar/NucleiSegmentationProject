chosen cell\nd = df_binned[df_binned[\"Cell_name\"] == chosen_cell_id].copy()\n\nd[\"is_tf\"]    = d[\"Gene_name\"].isin(tf_genes)\nd[\"is_glial\"] = d[\"Gene_name\"].isin(glial_genes)\nd[\"is_nuc\"]   = (d[\"Bin\"] == \"Nucleus\")   # note: column is 'Bin'\n\ndef enrich(flag_col):\n    a = int(( d[flag_col] &  d[\"is_nuc\"]).sum())  # feature in nucleus\n    b = int(( d[flag_col] & ~d[\"is_nuc\"]).sum())  # feature in cytoplasm\n    c = int((~d[flag_col] &  d[\"is_nuc\"]).sum())  # others in nucleus\n    e = int((~d[flag_col] & ~d[\"is_nuc\"]).sum())  # others in cytoplasm\n    odds, p = fisher_exact([[a,b],[c,e]], alternative=\"two-sided\")\n    nuc_pct = round(100 * a / (a+b), 2) if (a+b)>0 else 0.0\n    cyt_pct = round(100 * b / (a+b), 2) if (a+b)>0 else 0.0\n    return {\"nuc\":a, \"cyt\":b, \"nuc%\":nuc_pct, \"cyt%\":cyt_pct, \"odds\":odds, \"p\":p}\n\nres_tf    = enrich(\"is_tf\")\nres_glial = enrich(\"is_glial\")\n\nsummary = pd.DataFrame.from_dict({\n    \"TF (nuclear proxies)\": res_tf,\n    \"Glial markers\": res_glial\n}, orient=\"index\")[[\"nuc\",\"cyt\",\"nuc%\",\"cyt%\",\"odds\",\"p\"]]\n\nprint(f\"Cell: {chosen_cell_id}\")\ndisplay(summary)\n\n# Bar plot\nplt.figure(figsize=(4,4))\nplt.bar([\"TF\",\"Glial\"], [res_tf[\"nuc%\"], res_glial[\"nuc%\"]])\nplt.ylim(0,100); plt.ylabel(\"Nucleus %\"); plt.title(\"Nucleus% by gene class\")\nplt.show()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-10-06T20:17:23.887192Z","iopub.execute_input":"2025-10-06T20:17:23.887437Z","iopub.status.idle":"2025-10-06T20:17:24.014989Z","shell.execute_reply.started":"2025-10-06T20:17:23.887421Z","shell.execute_reply":"2025-10-06T20:17:24.014362Z"}},"outputs":[{"name":"stdout","text":"Cell: a558c878-fbcb-43f9-9757-9505640922dc\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"                      nuc  cyt   nuc%   cyt%  odds    p\nTF (nuclear proxies)    7   61  10.29  89.71   NaN  1.0\nGlial markers           0    0   0.00