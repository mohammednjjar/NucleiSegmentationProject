oundary safely\n    boundaryX = ast.literal_eval(cell_data[\"boundaryX\"].iloc[0])\n    boundaryY = ast.literal_eval(cell_data[\"boundaryY\"].iloc[0])\n\n    # Groups\n    inside = cell_data[cell_data[\"Inside_cell\"]]\n    outside = cell_data[~cell_data[\"Inside_cell\"]]\n\n    nuclear_tf = cell_data[cell_data[\"Gene_name\"].isin(nuclear_tfs)]\n    nuclear_non_tf = cell_data[cell_data[\"Gene_name\"].isin(nuclear_non_tfs)]\n    glial = cell_data[cell_data[\"Gene_name\"].isin(glial_genes)]\n    normal = cell_data[~cell_data[\"Gene_name\"].isin(nuclear_tfs + nuclear_non_tfs + glial_genes)]\n\n    # Splits\n    tf_in, tf_out = nuclear_tf[nuclear_tf[\"Inside_cell\"]], nuclear_tf[~nuclear_tf[\"Inside_cell\"]]\n    glial_in, glial_out = glial[glial[\"Inside_cell\"]], glial[~glial[\"Inside_cell\"]]\n    non_tf_in, non_tf_out = nuclear_non_tf[nuclear_non_tf[\"Inside_cell\"]], nuclear_non_tf[~nuclear_non_tf[\"Inside_cell\"]]\n    normal_in, normal_out = normal[normal[\"Inside_cell\"]], normal[~normal[\"Inside_cell\"]]\n\n    total_mols = len(cell_data)\n\n    # ---- Plot ----\n    fig, ax = plt.subplots(figsize=(12, 10))\n\n    # Cell boundary\n    ax.plot(boundaryX+[boundaryX[0]], boundaryY+[boundaryY[0]],\n            color=\"black\", linewidth=2, label=\"Cell boundary\")\n\n    # Hybrid nucleus polygon\n    if poly.geom_type == \"Polygon\":\n        x, y = poly.exterior.xy\n        ax.plot(x, y, color=\"red\", linewidth=2, label=\"Hybrid Nucleus Polygon\")\n    else:\n        for p in poly:\n            x, y = p.exterior.xy\n            ax.plot(x, y, color=\"red\", linewidth=2, label=\"Hybrid Nucleus Polygon\")\n\n    # Normal molecules (circles)\n    ax.scatter(normal_in[\"Centroid_X\"], normal_in[\"Centroid_Y\"],\n               c=\"green\", s=25, marker=\"o\",\n               label=f\"Normal inside ({len(normal_in)}, {len(normal_in)/total_mols*100:.1f}%)\")\n    ax.scatter(normal_out[\"Centroid_X\"], normal_out[\"Centroid_Y\"],\n               c=\"red\", s=25, marker=\"o\",\n               label=f\"Normal outside ({len(normal_out)}, {len(normal_out)/total_mols*100:.1f}%)\")\n\n    # Glials (squares)\n    ax.scatter(glial_in[\"Centroid_X\"], glial_in[\"Centroid_Y\"],\n               c=\"orange\", s=40, marker=\"s\", edgecolor=\"k\",\n               label=f\"Glial in ({len(glial_in)}, {len(glial_in)/total_mols*100:.1f}%)\")\n    ax.scatter(glial_out[\"Centroid_X\"], glial_out[\"Centroid_Y\"],\n               c=\"darkorange\", s=40, marker=\"s\", edgecolor=\"k\",\n               label=f\"Glial out ({len(glial_out)}, {len(glial_out)/total_mols*100:.1f}%)\")\n\n    # Nuclear TFs (triangles, depth-coded)\n    sc_tf_in = ax.scatter(tf_in[\"Centroid_X\"], tf_in[\"Centroid_Y\"],\n                          c=tf_in[\"Centroid_Z\"], cmap=\"viridis\",\n                          s=50, marker=\"^\", label=f\"TF in ({len(tf_in)}, {len(tf_in)/total_mols*100:.1f}%)\")\n    ax.scatter(tf_out[\"Centroid_X\"], tf_out[\"Centroid_Y\"],\n               c=tf_out[\"Centroid_Z\"], cmap=\"viridis\",\n               s=50, marker=\"^\", alpha=0.6,\n               label=f\"TF out ({len(tf_out)}, {len(tf_out)/total_mols*100:.1f}%)\")\n\n    # Nuclear non-TFs (diamonds)\n    ax.scatter(non_tf_in[\"Centroid_X\"], non_tf_in[\"Centroid_Y\"],\n               c=\"purple\", s=50, marker=\"D\",\n               label=f\"Nuclear non-TFs in ({len(non_tf_in)}, {len(non_tf_in)/total_mols*100:.1f}%)\")\n    ax.scatter(non_tf_out[\"Centroid_X\"], non_tf_out[\"Centroid_Y\"],\n               c=\"violet\", s=50, marker=\"D\",\n               label=f\"Nuclear non-TFs out ({len(non_tf_out)}, {len(non_tf_out)/total_mols*100:.1f}%)\")\n\n    # Title\n    ax.set_title(f\"Hybrid DAC Method — Cell {cell_id} | Total molecules = {total_mols}\", fontsize=14, pad=8)\n    ax.set_aspect(\"equal\")\n\n    # Legend\n    ax.legend(loc=\"center left\", bbox_to_anchor=(1.02, 0.5),\n              borderaxespad=0, fontsize=10, markerscale=1.5)\n\n    # Auto-zoom\n    pad_x = (max(boundaryX) - min(boundaryX)) * 0.09\n    pad_y = (max(boundaryY) - min(boundaryY)) * 0.09\n    ax.set_xlim(min(boundaryX) - pad_x, max(boundaryX) + pad_x)\n    ax.set_ylim(min(boundaryY) - pad_y, max(boundaryY) + pad_y)\n\n    # Colorbar for Z-depth (TFs only)\n    if len(tf_in) > 0:\n        divider = make_axes_locatable(ax)\n        cax = divider.append_axes(\"bottom\", size=\"5%\", pad=0.5)\n        cb = plt.colorbar(sc_tf_in, cax=cax, orientation=\"horizontal\")\n        cb.set_label(\"Z-depth (TFs)\")\n\n    plt.tight_layout()\n    plt.show()\n\n# ===============================\n# Example Run\n# ===============================\ncell_id = df_tf_bound[\"Cell_name\"].dropna().sample(1).values[0]\nplot_hybrid_full(chosen_cell_id)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-10-06T20:17:24.015685Z","iopub.execute_input":"2025-10-06T20:17:24.016007Z","iopub.status.idle":"2025-10-06T20:17:24.473940Z","shell.execute_reply.started":"2025-10-06T20:17:24.015980Z","shell.execute_reply":"2025-10-06T20:17:24.473171Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x1000 with 2 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":170},{"cell_type":"code","source":"# ===============================\n# Cell 34 Hybrid Full Visualization (Use df_unified for molecules + DAC polygon from df_tf_bound)\n# ===============================\ndef plot_hybrid_full(cell_id):\n    \"\"\"\n    Hybrid DAC nucleus visualization with all molecules:\n    - Normal molecules: green (inside), red (outside), circles\n    - Glials: orange squares\n    - Nuclear TFs: triangles (depth-coded)\n    - Nuclear non-TFs: purple diamonds\n    - DAC Hybrid polygon overlay from df_tf_bound\n    - Z-depth colorbar\n    \"\"\"\n    import ast\n\n    # ---- Get DAC polygon from df_tf_bound ----\n    cell_tf = df_tf_bound[df_tf_bound[\"Cell_name\"] == cell_id]\n    poly = hybrid_dbscan_alpha_kde(cell_tf)\n    if poly is None:\n        print(f\"⚠️ No valid polygon for ce