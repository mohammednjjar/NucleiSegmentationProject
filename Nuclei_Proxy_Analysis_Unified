))\nplt.bar([\"TF\",\"Glial\"], [res_tf[\"nuc%\"], res_glial[\"nuc%\"]])\nplt.ylim(0,100); plt.ylabel(\"Nucleus %\"); plt.title(\"Nucleus% by gene class\")\nplt.show()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-10-12T18:39:25.945419Z","iopub.execute_input":"2025-10-12T18:39:25.945647Z","iopub.status.idle":"2025-10-12T18:39:26.075544Z","shell.execute_reply.started":"2025-10-12T18:39:25.945622Z","shell.execute_reply":"2025-10-12T18:39:26.075025Z"}},"outputs":[{"name":"stdout","text":"Cell: a558c878-fbcb-43f9-9757-9505640922dc\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"                      nuc  cyt   nuc%   cyt%  odds    p\nTF (nuclear proxies)    7   61  10.29  89.71   NaN  1.0\nGlial markers           0    0   0.00   0.00   NaN  1.0","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>nuc</th>\n      <th>cyt</th>\n      <th>nuc%</th>\n      <th>cyt%</th>\n      <th>odds</th>\n      <th>p</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>TF (nuclear proxies)</th>\n      <td>7</td>\n      <td>61</td>\n      <td>10.29</td>\n      <td>89.71</td>\n      <td>NaN</td>\n      <td>1.0</td>\n    </tr>\n    <tr>\n      <th>Glial markers</th>\n      <td>0</td>\n      <td>0</td>\n      <td>0.00</td>\n      <td>0.00</td>\n      <td>NaN</td>\n      <td>1.0</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 400x400 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":92},{"cell_type":"code","source":"# Cell 27 — Hybrid DAC Visualization (TFs only)\ndef plot_hybrid_full(cell_id):\n    \"\"\"\n    Hybrid DAC nucleus visualization:\n    - Normal molecules: green (inside), red (outside), circles\n    - Glials: orange squares\n    - Nuclear TFs: triangles, depth-coded (DAC polygon applied)\n    - Nuclear non-TFs: purple diamonds\n    - Counts + percentages in legend\n    - DAC nucleus polygon + cell boundary\n    - Z-depth colorbar\n    \"\"\"\n    cell_data = df_tf_bound[df_tf_bound[\"Cell_name\"] == cell_id]\n    poly = hybrid_dbscan_alpha_kde(cell_data)  # DAC: DBSCAN + Alpha + KDE\n    if poly is None:\n        print(f\"⚠️ No valid polygon for cell {cell_id}\")\n        return\n\n    boundaryX = ast.literal_eval(cell_data[\"boundaryX\"].iloc[0])\n    boundaryY = ast.literal_eval(cell_data[\"boundaryY\"].iloc[0])\n\n    inside = cell_data[cell_data[\"Inside_cell\"]]\n    outside = cell_data[~cell_data[\"Inside_cell\"]]\n\n    nuclear_tf = cell_data[cell_data[\"Gene_name\"].isin(nuclear_tfs)]\n    nuclear_non_tf = cell_data[cell_data[\"Gene_name\"].isin(nuclear_non_tfs)]\n    glial = cell_data[cell_data[\"Gene_name\"].isin(glial_genes)]\n    normal = cell_data[~cell_data[\"Gene_name\"].isin(nuclear_tfs + nuclear_non_tfs + glial_genes)]\n\n    tf_in, tf_out = nuclear_tf[nuclear_tf[\"Inside_cell\"]], nuclear_tf[~nuclear_tf[\"Inside_cell\"]]\n    glial_in, glial_out = glial[glial[\"Inside_cell\"]], glial[~glial[\"Inside_cell\"]]\n    non_tf_in, non_tf_out = nuclear_non_tf[nuclear_non_tf[\"Inside_cell\"]], nuclear_non_tf[~nuclear_non_tf[\"Inside_cell\"]]\n    normal_in, normal_out = normal[normal[\"Inside_cell\"]], normal[~normal[\"Inside_cell\"]]\n\n    total_mols = len(cell_data)\n\n    fig, ax = plt.subplots(figsize=(12, 10))\n    ax.plot(boundaryX+[boundaryX[0]], boundaryY+[boundaryY[0]], color=\"black\", lw=2, label=\"Cell boundary\")\n\n    if poly.geom_type == \"Polygon\":\n        x, y = poly.exterior.xy\n        ax.plot(x, y, color=\"red\", lw=2, label=\"Hybrid Nucleus Polygon\")\n    else:\n        for p in poly:\n            x, y = p.exterior.xy\n          