</th>\n      <td>203</td>\n      <td>0</td>\n      <td>203</td>\n      <td>0.00</td>\n    </tr>\n    <tr>\n      <th>9252ddd6-3986-4893-8047-cdb5c9ed6ec0</th>\n      <td>44</td>\n      <td>0</td>\n      <td>44</td>\n      <td>0.00</td>\n    </tr>\n  </tbody>\n</table>\n<p>6313 rows × 4 columns</p>\n</div>"},"metadata":{}}],"execution_count":83},{"cell_type":"code","source":"# Cell 18 — Nucleus Proxy Comparison (CHOSEN cell, nuclear TFs only; 12 methods; CLIPPED)\n# Guarantees:\n# 1) Use nuclear TFs INSIDE chosen cell\n# 2) Build nucleus proxy masks from them\n# 3) Clip proxies strictly to the cell boundary\n# optional alphashape\ntry:\n    import alphashape\n    _HAS_ALPHA = True\nexcept Exception:\n    _HAS_ALPHA = False\n\n# normalize IDs\ndf_tf_bound[\"Cell_name\"] = df_tf_bound[\"Cell_name\"].astype(str).str.strip()\ndf_boundaries[\"feature_uID\"] = df_boundaries[\"feature_uID\"].astype(str).str.strip()\n\ndef _clip_poly(poly, boundary_poly):\n    if poly is None: return None\n    try:\n        c = poly.intersection(boundary_poly)\n    except Exception:\n        return None\n    if c.is_empty: return None\n    if c.geom_type == \"Polygon\": return c\n    if hasattr(c, \"geoms\"):\n        polys = [p for p in c.geoms if p.geom_type == \"Polygon\"]\n        return max(polys, key=lambda p: p.area) if polys else None\n    return None\n\ndef _gmm_ellipse(points, scale=1.5, n=100):\n    if len(points) < 3: return None\n    X = np.asarray(points)\n    g = GaussianMixture(n_components=1, covariance_type=\"full\", random_state=0).fit(X)\n    mu = g.means_[0]; cov = g.covariances_[0]\n    vals, vecs = np.linalg.eigh(cov)\n    order = vals.argsort()[::-1]; vals, vecs = vals[order], vecs[:, order]\n    t = np.linspace(0, 2*np.pi, n)\n    ellipse = mu + (vecs @ (np.sqrt(np.maximum(vals, 1e-9))[:, None] *\n                            np.vstack([np.cos(t), np.sin(t)]) * scale)).T\n    poly = Polygon(ellipse)\n    return poly if poly.is_valid else poly.buffer(0)\n\ndef _kde_hull(points, k=10, q=0.65):\n    if len(points) < 3: return None\n    X = np.asarray(points); k = min(k, len(points)-1)\n    nbrs = NearestNeighbors(n_neighbors=k+1).fit(X)\n    dists, _ = nbrs.kneighbors(X)\n    dens = 1.0 / (dists[:, -1] + 1e-9)\n    keep = X[dens >= np.quantile(dens, q)]\n    if len(keep) < 3: return None\n    poly = MultiPoint([tuple(p) for p in keep]).convex_hull\n    return poly if poly.is_valid else poly.buffer(0)\n\ndef _buffer_union(points, r=3.0):\n    if len(points) < 1: return None\n    geoms = [Point(p).buffer(r) for p in points]\n    u = unary_union(geoms)\n    if u.is_empty: return None\n    if u.geom_type == \"Polygon\": return u\n    if hasattr(u, \"geoms\"):\n        polys = [g for g in u.geoms if g.geom_type == \"Polygon\"]\n        return max(polys, key=lambda p: p.area) if polys else None\n    return None\n\ndef _min_rect(mp):\n    if mp is None or mp.is_empty: return None\n    hull = mp.convex_hull\n    rect = hull.minimum_rotated_rectangle if hasattr(hull, \"minimum_rotated_rectangle\") else hull\n    return rect if rect.is_valid else rect.buffer(0)\n\ndef _smooth_hull(poly, r=2.0):\n    if poly is None or poly.is_empty: return None\n    try:\n        s = poly.buffer(r).buffer(-r)\n        if s.is_empty: return None\n        if s.geom_type == \"Polygon\": return s\n        if hasattr(s, \"geoms\"):\n            polys = [g for g in s.geoms if g.geom_type == \"Polygon\"]\n            return max(polys, key=lambda p: p.area) if polys else None\n    except Exception:\n        pass\n    return poly\n\ndef _z_core_hull(tf_df, q=0.5):\n    if tf_df is None or tf_df.empty: return None\n    zthr = tf_df[\"Centroid_Z\"].quantile(q)\n    core = tf_df[tf_df[\"Centroid_Z\"] >= zthr]\n    if len(core) < 3: return None\n    poly = MultiPoint(list(zip(core[\"Centroid_X\"], core[\"Centroid_Y\"]))).convex_hull\n    return poly if poly.is_valid else poly.buffer(0)\n\ndef plot_all_methods_for_chosen(alpha_fixed=0.05, eps=10, min_samples=3):\n    cid = str(chosen_cell_id).strip()\n\n    # --- data ---\n    cell = df_tf_bound[df_tf_bound[\"Cell_name\"] == cid]\n    tf = cell[(cell[\"Inside_cell\"] == True) & (cell[\"Gene_name\"].isin(nuclear_tfs))]\n    row = df_boundaries[df_boundaries[\"feature_uID\"] == cid]\n    if row.empty: \n        raise RuntimeError(f\"No boundary for cell {cid}\")\n    bx = ast.literal_eval(row.iloc[0][\"boundaryX\"])\n    by = ast.literal_eval(row.iloc[0][\"boundaryY\"])\n    boundary_poly = Polygon(list(zip(bx, by)))\n\n    pts = list(zip(tf[\"Centroid_X\"], tf[\"Centroid_Y\"]))\n    mp  = MultiPoint(pts) if len(pts) else None\n\n    # --- methods (exactly 12) ---\n    methods = OrderedDict()\n\n    # 1 Convex Hull\n    methods[\"Convex Hull\"] = (mp.convex_hull if mp else None)\n\n    # 2 Alpha Shape (α=fixed)\n    methods[\"Alpha Shape\"] = (alphashape.alphashape(pts, alpha_fixed) if _HAS_ALPHA and len(pts) >= 4\n                              else (mp.convex_hull if mp else None))\n\n    # 3 DBSCAN+Hull\n    if len(pts) >= 2:\n        lbls = DBSCAN(eps=eps, min_samples=min_samples).fit(pts).labels_\n        core = [p for p, l in zip(pts, lbls) if l != -1]\n        methods[\"DBSCAN+Hull\"] = MultiPoint(core).convex_hull if len(core) >= 3 else (mp.convex_hull if mp else None)\n    else:\n        core = []\n        methods[\"DBSCAN+Hull\"] = (mp.convex_hull if mp else None)\n\n    # 4 GMM Ellipse\n    methods[\"GMM Ellipse\"] = _gmm_ellipse(pts, scale=1.5) if len(pts) >= 4 else (mp.convex_hull if mp else None)\n\n    # 5 DBSCAN→Alpha\n    methods[\"DBSCAN→Alpha\"] = (alphashape.alphashape(core, alpha_fixed) if _HAS_ALPHA and len(core) >= 4\n                               else (MultiPoint(core).convex_hull if len(core) >= 3 else None))\n\n    # 6 KDE→Hull\n    methods[\"KDE→Hull\"] = _kde_hull(pts, k=10, q=0.65) if len(pts) >= 3 else None\n\n    # 7 Buffered Union (r=3)\n    methods[\"Buffered Union (r=3)\"] = _buffer_union(pts, r=3.0)\n\n    # 8 Min Rotated Rectangle\n    methods[\"Min Rotated Rectangle\"] = _min_rect(mp)\n\n    # 9 Smoothed Hull (±2)\n    methods[\"Smoothed Hull\"] = _smooth_hull(methods[\"Convex Hull\"], r=2.0)\n\n    # 10 Z-Core Hull (top 50% Z)\n    methods[\"Z-Core Hull (q=0.5)\"] = _z_core_hull(tf, q=0.5)\n\n    # 11 Voronoi (overlay)\n    try:\n        methods[\"Voronoi\"] = Voronoi(pts) if len(pts) >= 3 else None\n    except Exception:\n        methods[\"Voronoi\"] = None\n\n    # 12 Alpha Shape (tight)\n    tight_alpha = max(alpha_fixed * 0.5, 0.005)\n    methods[\"Alpha Shape (tight)\"] = (alphashape.alphashape(pts, tight_alpha) if _HAS_ALPHA and len(pts) >= 4\n                                      else (mp.convex_hull if mp else None))\n\n    # --- plot ---\n    fig, axes = plt.subplots(3, 4, figsize=(28, 18))\n    if len(tf):\n        z = tf[\"Centroid_Z\"].to_numpy(); norm = plt.Normalize(z.min(), z.max())\n    else:\n        z = np.array([0, 1]); norm = plt.Normalize(0, 1)\n\n    for ax, (name, poly) in zip(axes.flat, methods.items()):\n        ax.plot(bx, by, \"k-\", lw=1)\n        if name == \"Voronoi\" and poly is not None:\n            voronoi_plot_2d(poly, ax=ax, show_vertices=False, line_colors=\"orange\")\n        else:\n            if len(tf):\n                ax.scatter(tf[\"Centroid_X\"], tf[\"Centroid_Y\"], c=z, cmap=plt.cm.viridis, norm=norm,\n                           alpha=0.85, edgecolors=\"k\", linewidths=0.2, s=30)\n            clipped = _clip_poly(poly, boundary_poly)\n            if clipped is not None:\n                x, y = clipped.exterior.xy; ax.plot(x, y, \"r--\", lw=2)\n        ax.set_title(name); ax.set_xlabel(\"X\"); ax.set_ylabel(\"Y\")\n\n    # colorbar\n    cax = fig.add_axes([0.15, 0.03, 0.7, 0.02])\n    fig.colorbar(cm.ScalarMappable(norm=norm, cmap=plt.cm.viridis), cax=cax,\n                 orientation=\"horizontal\", label=\"Centroid Z\")\n\n    # legend\n    total = int(len(cell)); inside_n = int((cell[\"Inside_cell\"] == True).sum()); outside_n = total - inside_n\n    inside_pct = (inside_n / total * 100) if total > 0 else 0.0\n    outside_pct = (outside_n / total * 100) if total > 0 else 0.0\n    leg = [\n        mlines.Line2D([], [], color=\"black\", lw=2, label=\"Cell boundary\"),\n        mlines.Line2D([], [], color=\"red\", ls=\"--\", lw=2, label=\"Nucleus proxy (clipped)\"),\n        mlines.Line2D([], [], marker=\"o\", color=\"green\", lw=0, label=f\"Inside ({inside_n}, {inside_pct:.1f}%)\"),\n        mlines.Line2D([], [], marker=\"o\", color=\"red\", lw=0, label=f\"Outside ({outside_n}, {outside_pct:.1f}%)\"),\n    ]\n    fig.legend(handles=leg, loc=\"center left\", bbox_to_anchor=(0.9, 0.5), frameon=True, title=\"Legend\", fontsize=9)\n\n    plt.suptitle(f\"Nucleus Proxy Comparison (TF-only) — 12 Methods — Cell {cid}\", fontsize=16)\n    plt.tight_layout(rect=[0, 0.03, 0.9, 0.95]); plt.show()\n\n# Run for chosen cell\nplot_all_methods_for_chosen()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-10-12T18:36:58.586913Z","iopub.execute_input":"2025-10-12T18:36:58.587164Z","iopub.status.idle":"2025-10-12T18:37:01.117195Z","shell.execute_reply.started":"2025-10-12T18:36:58.587133Z","shell.execute_reply":"2025-10-12T18:37:01.116398Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 2800x1800 with 13 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":84},{"cell_type":"code","source":"# Cell 19 Inspect how many nuclear TFs are inside the chosen cell\ncid = str(chosen_cell_id).strip()\n\ncell = df_tf_bound[df_tf_bound[\"Cell_name\"] == cid]\ntf_only = cell[(cell[\"Inside_cell\"] == True) & (cell[\"Gene_name\"].isin(nuclear_tfs))]\n\nprint(\"Total molecules in cell:\", len(cell))\nprint(\"Nuclear TFs inside:\", len(tf_only))\nprint(tf_only[\"Gene_name\"].value_counts())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-10-12T18:37:01.118031Z","iopub.execute_input":"2025-10-12T18:37:01.118712Z","iopub.status.idle":"2025-10-12T18:37:01.141326Z","shell.execute_reply.started":"2025-10-12T18:37:01.118688Z","shell.execute_reply":"2025-10-12T18:37:01.140567Z"}},"outputs":[{"name":"stdout","text":"Total molecules in cell: 68\nNuclear TFs inside: 63\nGene_name\nEsr1       31\nAr         13\nSox4        5\nOnecut2     4\nEtv1        3\nPou3f2      3\nNpas1       2\nEbf3        1\nSox8        1\nName: count, dtype: int64\n","output_type":"stream"}],"execution_count":85},{"cell_type":"code","source":"# Cell 20 Hybrid DBSCAN → Alpha Shape (Restricted to Nuclear TFs)\n# Fixed to chosen_cell_id\n# Nuclear gene list (includes TFs + strong nuclear markers)\nnuclear_gene_list = [\"MKI67\",\"CENPE\"] + nuclear_tfs + nuclear_non_tfs\n\ndef nucleus_proxy_hybrid(cell_id, eps=5, min_samples=4, alpha=0.02):\n    \"\"\"\n    Hybrid nucleus proxy: DBSCAN → Alpha Shape restricted to nuclear genes.\n    Guarantees:\n      1) Only nuclear TF/proxy genes inside cell\n      2) Nucleus mask clipped to boundary\n      3) Always use chosen_cell_id (not random)\n    \"\"\"\n    # Filter for this cell + nuclear genes\n    cell_data = df_tf_bound[df_tf_bound[\"Cell_name\"] == cell_id]\n    tf_data = cell_data[(cell_data[\"Inside_cell\"] == True) &\n                        (cell_data[\"Gene_name\"].isin(nuclear_gene_list))]\n    \n    if len(tf_data) < 4:\n        print(f\"Cell {cell_id} has too few nuclear molecules ({len(tf_data)}).\")\n        return\n    \n    # Boundary\n    boundary_row = df_boundaries[df_boundaries[\"feature_uID\"] == cell_id].iloc[0]\n    boundaryX = ast.literal_eval(boundary_row[\"boundaryX\"])\n    boundaryY = ast.literal_eval(boundary_row[\"boundaryY\"])\n    boundary_poly = Polygon(list(zip(boundaryX, boundaryY)))\n    \n    # Points\n    points = list(zip(tf_data[\"Centroid_X\"], tf_data[\"Centroid_Y\"]))\n    \n    # DBSCAN\n    clustering = DBSCAN(eps=eps, min_samples=min_samples).fit(points)\n    cluster_points = [p for p, lbl in zip(points, clustering.labels_) if lbl != -1]\n    \n    if len(cluster_points) < 3:\n        print(f\"Cell {cell_id} did not form a dense cluster with DBSCAN.\")\n        return\n    \n    # Alpha Shape\n    try:\n        nucleus_mask = alphashape.alphashape(cluster_points, alpha=alpha)\n    except:\n        nucleus_mask = MultiPoint(cluster_points).convex_hull\n    \n    # Clip to boundary\n    nucleus_mask = nucleus_mask.intersection(boundary_poly)\n    \n    # Counts\n    inside_count = (cell_data[\"Inside_cell\"] == True).sum()\n    outside_count = (cell_data[\"Inside_cell\"] == False).sum()\n    total = inside_count + outside_count\n    inside_pct = (inside_count/total*100) if total > 0 else 0\n    outside_pct = (outside_count/total*100) if total > 0 else 0\n    \n    summary = tf_data[\"Gene_name\"].value_counts()\n    \n    # ===== PLOT =====\n    fig, ax = plt.subplots(figsize=(7, 7))\n    cmap = plt.cm.viridis\n    norm = plt.Normalize(tf_data[\"Centroid_Z\"].min(), tf_data[\"Centroid_Z\"].max())\n    \n    # Boundary\n    ax.plot(boundaryX, boundaryY, \"k-\", linewidth=1)\n    \n    # Molecules\n    ax.scatter(tf_data[\"Centroid_X\"], tf_data[\"Centroid_Y\"],\n               c=tf_data[\"Centroid_Z\"], cmap=cmap, norm=norm,\n               edgecolors=\"k\", linewidths=0.2, s=40, alpha=0.9)\n    \n    # Nucleus mask\n    if nucleus_mask and not nucleus_mask.is_empty:\n        x, y = nucleus_mask.exterior.xy\n        ax.plot(x, y, \"r--\", linewidth=2)\n    \n    # Colorbar\n    cbar_ax = fig.add_axes([0.15, -0.07, 0.7, 0.03])\n    cbar = fig.colorbar(cm.ScalarMappable(norm=norm, cmap=cmap),\n                        cax=cbar_ax, orientation=\"horizontal\")\n    cbar.set_label(\"Centroid Z\")\n    \n    # Legend\n    legend_handles = [\n        mlines.Line2D([], [], color=\"red\", linestyle=\"--\", linewidth=2,\n                      label=\"Nucleus proxy (Hybrid)\"),\n        mlines.Line2D([], [], color=\"black\", linewidth=2,\n                      label=\"Cell boundary\"),\n        mlines.Line2D([], [], color=\"green\", marker=\"o\", linestyle=\"None\",\n     