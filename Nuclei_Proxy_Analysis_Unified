 [by[0]], \"k-\", lw=1.8, label=\"Cell Boundary\")\nplt.scatter(cell_tf[\"Centroid_X\"], cell_tf[\"Centroid_Y\"], s=20, c=\"blue\",\n            label=f\"TF molecules (n={len(cell_tf)})\")\n\nif alpha_shape is not None:\n    geoms = list(alpha_shape.geoms) if isinstance(alpha_shape, MultiPolygon) else [alpha_shape]\n    for g in geoms:\n        if isinstance(g, Polygon):\n            x, y = g.exterior.xy\n            plt.plot(list(x), list(y), \"r--\", lw=2, label=\"Nucleus Mask (Alpha Shape)\")\n            break\n\nplt.title(f\"Nucleus Proxy (Alpha Shape) — Cell {cell_id}\")\nplt.xlabel(\"X\"); plt.ylabel(\"Y\"); plt.axis(\"equal\"); plt.legend(); plt.show()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-10-06T20:14:14.727102Z","iopub.execute_input":"2025-10-06T20:14:14.727338Z","iopub.status.idle":"2025-10-06T20:14:21.659150Z","shell.execute_reply.started":"2025-10-06T20:14:14.727322Z","shell.execute_reply":"2025-10-06T20:14:21.658418Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 700x700 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":158},{"cell_type":"code","source":"# ===============================\n# Cell 21 Step 8 — Enrichment vs Nucleus Mask (chosen_cell_id) — CONSOLIDATED OUTPUT\n# ===============================\n\n# safe import (alphashape)\ntry:\n    import alphashape\nexcept ModuleNotFoundError:\n    import sys, subprocess\n    subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"alphashape\"])\n    import alphashape\n\nfrom shapely.geometry import Point, MultiPoint, Polygon\nimport ast, numpy as np, pandas as pd\n\n# --- gene sets ---\nnuclear_tfs     = [\"Ar\",\"Esr1\",\"Sox4\",\"Sox6\",\"Sox8\",\"Pou3f2\",\"Onecut2\",\"Etv1\",\"Klf4\",\"Npas1\",\"Ebf3\",\"Gbx2\"]\nnuclear_non_tfs = [\"Ccnd2\",\"Cdkn1a\"]\nglial_genes     = [\"Aqp4\",\"Aldh1l1\",\"Gfap\",\"Slc1a3\",\"Slc1a2\",\"Mbp\",\"Mog\",\"Plp1\",\"Cnp\",\"Sox10\",\n                   \"Cx3cr1\",\"Itgam\",\"P2ry12\",\"Tmem119\",\"Aif1\",\"Cspg4\",\"Pdgfra\"]\n\ncell_id = chosen_cell_id\n\n# --- boundary polygon ---\nrow = df_boundaries[df_boundaries[\"feature_uID\"] == cell_id].iloc[0]\nbx = ast.literal_eval(row[\"boundaryX\"]); by = ast.literal_eval(row[\"boundaryY\"])\nboundary_poly = Polygon(list(zip(bx, by)))\n\n# --- molecules inside boundary only ---\ncell_mols = df_merfish[df_merfish[\"Cell_name\"] == cell_id].copy()\ncell_mols[\"Inside_cell\"] = [boundary_poly.contains(Point(x, y))\n                            for x, y in zip(cell_mols[\"Centroid_X\"], cell_mols[\"Centroid_Y\"])]\ncell_mols = cell_mols[cell_mols[\"Inside_cell\"]].copy()\n\n# --- nucleus mask from TFs (alpha-shape → convex-hull fallback) ---\ntf_in = cell_mols[cell_mols[\"Gene_name\"].isin(nuclear_tfs)].copy()\npts2d = [(x, y) for x, y in zip(tf_in[\"Centroid_X\"], tf_in[\"Centroid_Y\"])]\n\nnucleus_mask = None\nif len(pts2d) >= 4:\n    try:\n        alpha = float(np.clip(alphashape.optimizealpha(pts2d), 0.01, 1.0))\n        nucleus_mask = alphashape.alphashape(pts2d, alpha)\n    except Exception:\n        nucleus_mask = MultiPoint([Point(p) for p in pts2d]).convex_hull\nelif len(pts2d) >= 3:\n    nucleus_mask = MultiPoint([Point(p) for p in pts2d]).convex_hull\n\n# --- helpers ---\ndef counts_in_mask(df, mask):\n    if mask is None:\n        return 0, int(len(df))\n    inside_mask = [mask.contains(Point(x, y)) for x, y in zip(df[\"Centroid_X\"], df[\"Centroid_Y\"])]\n    n_in = int(np.sum(inside_mask)); n_out = int(len(df) - n_in)\n    return n_in, n_out\n\neps = 1e-9\ncell_area = float(boundary_poly.area)\nmask_area  = float(nucleus_mask.area) if isinstance(nucleus_mask, Polygon) else np.nan\nmask_area_safe   = mask_area  if (isinstance(mask_area,  float) and mask_area  > eps) else np.nan\noutside_area     = (cell_area - mask_area) if isinstance(mask_area, float) else np.nan\noutside_area_safe= outside_area if (isinstance(outside_area, float) and outside_area > eps) else np.nan\n\n# --- GROUP summary ---\ngroups = {\n    \"Nuclear_TFs\":    cell_mols[cell_mols[\"Gene_name\"].isin(nuclear_tfs)],\n    \"Nuclear_nonTFs\": cell_mols[cell_mols[\"Gene_name\"].isin(nuclear_non_tfs)],\n    \"Glial_markers\":  cell_mols[cell_mols[\"Gene_name\"].isin(glial_genes)],\n}\ng_rows = []\nfor name, df in groups.items():\n    n_in, n_out = counts_in_mask(df, nucleus_mask)\n    total = n_in + n_out\n    inside_pct = round(100 * n_in / total, 2) if total > 0 else 0.0\n    dens_in  = (n_in  / mask_area_safe)    if np.isfinite(mask_area_safe)    else np.nan\n    dens_out = (n_out / outside_area_safe) if np.isfinite(outside_area_safe) else np.nan\n    enr = (dens_in / dens_out) if (np.isfinite(dens_in) and np.isfinite(dens_out) and dens_out > 0) else np.nan\n    g_rows.append([name, n_in, n_out, total, inside_pct, dens_in, dens_out, enr])\n\ngroup_df = pd.DataFrame(g_rows, columns=[\"Name\",\"Inside_mask\",\"Outside_mask\",\"Total_in_cell\",\n                                         \"Inside_mask_%\",\"Density_in\",\"Density_out\",\"Enrichment_ratio\"])\ngroup_df.insert(0, \"Type\", \"Group\")\n\n# --- PER-GENE TF summary ---\nif nucleus_mask is None:\n    tf_counts = tf_in.assign(InMask=False).groupby([\"Gene_name\",\"InMask\"]).size().unstack(fill_value=0)\nelse:\n    tf_counts = (\n        tf_in.assign(InMask=[nucleus_mask.contains(Point(x, y)) for x, y in zip(tf_in[\"Centroid_X\"], tf_in[\"Centroid_Y\"])])\n            .groupby([\"Gene_name\",\"InMask\"]).size().unstack(fill_value=0)\n    )\ntf_counts.rename(columns={True:\"Inside_mask\", False:\"Outside_mask\"}, inplace=True)\ntf_counts[\"Total_in_cell\"] = tf_counts.sum(axis=1)\ntf_counts[\"Inside_mask_%\"] = (100*tf_counts[\"Inside_mask\"]/tf_counts[\"Total_in_cell\"]).round(2)\n\n# safe densities (fix for scalar .where bug)\nif np.isfinite(mask_area_safe):\n    tf_counts[\"Density_in\"] = tf_counts[\"Inside_mask\"] / mask_area_safe\nelse:\n    tf_counts[\"Density_in\"] = np.nan\nif np.isfinite(outside_area_safe):\n    tf_counts[\"Density_out\"] = tf_counts[\"Outside_mask\"] / outside_area_safe\nelse:\n    tf_counts[\"Density_out\"] = np.nan\n\ntf_counts[\"Enrichment_ratio\"] = (\n    tf_counts[\"Density_in\"] / tf_counts[\"Density_out\"]\n).replace([np.inf, -np.inf], np.nan).round(4)\n\ngene_df = tf_counts.reset_index().rename(columns={\"Gene_name\":\"Name\"})\ngene_df.insert(0, \"Type\", \"Gene\")\n\n# --- SINGLE consolidated table ---\nfinal_tbl = pd.concat([group_df, gene_df], ignore_index=True)\ndisplay(final_tbl)\n\n# Areas (context)\nif nucleus_mask is None:\n    print(\"Note: Not enough TF molecules to define a nucleus mask; counts are inside-cell only.\")\nelse:\n    print(f\"Areas (μm²): cell={cell_area:.2f}, nucleus_mask={mask_area:.2f}, outside_mask={outside_area:.2f}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-10-06T20:14:21.659991Z","iopub.execute_input":"2025-10-06T20:14:21.660249Z","iopub.status.idle":"2025-10-06T20:14:28.304007Z","shell.execute_reply.started":"2025-10-06T20:14:21.660231Z","shell.execute_reply":"2025-10-06T20:14:28.303305Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"     Type            Name  Inside_mask  Outside_mask  Total_in_cell  \\\n0   Group     Nuclear_TFs           52            11             63   \n1   Group  Nuclear_nonTFs            1             0              1   \n2   Group   Glial_markers            3             2              5   \n3    Gene              Ar           12             1             13   \n4    Gene            Ebf3            1             0              1   \n5    Gene            Esr1           23             8             31   \n6    Gene            Etv1            3             0              3   \n7    Gene           Npas1            2             0              2   \n8    Gene         Onecut2            4             0              4   \n9    Gene          Pou3f2            1             2              3   \n10   Gene            Sox4            5       