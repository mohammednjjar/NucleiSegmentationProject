ashape.alphashape(core, alpha)\n    if alpha_poly.is_empty:\n        return None\n\n    # KDE refine\n    kde = gaussian_kde(core.T)\n    dens = kde(core.T)\n    thresh = np.quantile(dens, kde_levels[0])\n    dense = core[dens >= thresh]\n    kde_poly = alphashape.alphashape(dense, alpha) if dense.shape[0] >= 3 else alpha_poly\n\n    # Intersection for final\n    final_poly = alpha_poly.intersection(kde_poly)\n    if getattr(final_poly, \"is_empty\", True):\n        final_poly = alpha_poly\n    return final_poly\n\ndef _parse_xy(x):\n    if isinstance(x, str):\n        return ast.literal_eval(x)\n    if isinstance(x, (list, tuple, np.ndarray)):\n        return list(x)\n    raise TypeError(f\"Unsupported boundary type: {type(x)}\")\n\n# ----- RUN (fixed cell, not random) -----\ncid = str(chosen_cell_id).strip()\n\ncell_data = df_tf_bound[df_tf_bound[\"Cell_name\"] == cid].copy()\n\n# If you want only inside molecules, uncomment the next line:\n# cell_data = cell_data[cell_data[\"Inside_cell\"] == True]\n\n# Prefer boundary from df_boundaries for reliability\nbrow = df_boundaries[df_boundaries[\"feature_uID\"] == cid]\nif brow.empty:\n    raise RuntimeError(f\"No boundary for cell {cid}\")\nbx = _parse_xy(brow.iloc[0][\"boundaryX\"])\nby = _parse_xy(brow.iloc[0][\"boundaryY\"])\nboundary_poly = Polygon(list(zip(bx, by)))\n\npoly = hybrid_dbscan_alpha_kde(cell_data, eps=15, min_samples=3, alpha=0.05, kde_levels=(0.8,))\n\nif poly is not None:\n    plt.figure(figsize=(6, 6))\n    plt.scatter(cell_data[\"Centroid_X\"], cell_data[\"Centroid_Y\"],\n                s=20, alpha=0.6, label=\"Molecules\")\n    # cell boundary\n    plt.plot(bx + [bx[0]], by + [by[0]], color=\"black\", linewidth=2, label=\"Cell Boundary\")\n\n    # hybrid polygon (handle Polygon or MultiPolygon)\n    geoms = [poly] if isinstance(poly, Polygon) else (list(poly.geoms) if isinstance(poly, MultiPolygon) else [])\n    for g in geoms:\n        x, y = g.exterior.xy\n        plt.plot(x, y, color=\"red\", linewidth=2, label=\"Hybrid Nucleus Polygon\")\n\n    plt.legend()\n    plt.title(f\"Hybrid DBSCAN+Alpha+KDE — Cell {cid[:8]}\")\n    plt.axis(\"equal\")\n    plt.show()\nelse:\n    print(f\"⚠️ No valid polygon for cell {cid}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-10-06T20:14:56.290601Z","iopub.execute_input":"2025-10-06T20:14:56.290855Z","iopub.status.idle":"2025-10-06T20:14:56.542863Z","shell.execute_reply.started":"2025-10-06T20:14:56.290839Z","shell.execute_reply":"2025-10-06T20:14:56.542150Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 600x600 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":165},{"cell_type":"code","source":"# ===============================\n# Cell 29 Step — Hybrid Nuclei-Specific Binning\n# Compare with Alpha-only\n# ===============================\n\nfrom shapely.geometry import Point\n\n# Create a copy of MERFISH with Hybrid Nucleus/Cytoplasm labels\ndf_hybrid_binned = df_tf_bound.copy()\ndf_hybrid_binned[\"Bin\"] = \"Cytoplasm\"   # default\n\n# Loop per cell and apply hybrid nucleus mask\nfor cell_id, group in df_tf_bound.groupby(\"Cell_name\"):\n    mask = hybrid_dbscan_alpha_kde(group, eps=15, min_samples=3, alpha=0.05, kde_levels=[0.8])\n    if mask:\n        inside_mask = [\n            \"Nucleus\" if mask.contains(Point(x, y)) else \"Cytoplasm\"\n            for x, y in zip(group[\"Centroid_X\"], group[\"Centroid_Y\"])\n        ]\n        df_hybrid_binned.loc[group.index, \"Bin\"] = inside_mask\n\n# Summarize hybrid binning\nhybrid_summary = df_hybrid_binned.groupby([\"Gene_name\",\"Bin\"]).size().unstack(fill_value=0)\ndisplay(hybrid_summary.head(20))\n\n# Save final hybrid-binned dataset\ndf_hybrid_binned.to_csv(\"MERFISH_hybrid_nuclei_specific_binning.csv\", index=False)\nprint(\"✅ Saved as MERFISH_hybrid_nuclei_specific_binning.csv\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-10-06T20:14:56.543681Z","iopub.execute_inp