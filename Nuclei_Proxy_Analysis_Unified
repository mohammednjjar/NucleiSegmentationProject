ell\"].apply(lambda s: (~s).sum())\n}).reset_index()\n\n# 4) Merge boundary quality\nboundary_qc = (\n    df_unified[[\"Cell_name\",\"boundaryX\",\"boundaryY\"]]\n      .drop_duplicates(\"Cell_name\")\n      .assign(boundary_len=lambda d: d.apply(boundary_len, axis=1))\n      [[\"Cell_name\",\"boundary_len\"]]\n)\nmetrics = metrics.merge(boundary_qc, on=\"Cell_name\", how=\"left\").fillna({\"boundary_len\":0})\n\n# 5) Scores (tune thresholds if needed)\nmetrics[\"tf_ratio\"]   = metrics[\"n_tf\"] / metrics[\"n_total\"].replace(0, np.nan)\nmetrics[\"inside_pct\"] = metrics[\"n_inside\"] / metrics[\"n_total\"].replace(0, np.nan)\nmetrics[\"score\"] = (\n    0.50*metrics[\"n_tf\"].rank(pct=True) +\n    0.25*metrics[\"inside_pct\"].rank(pct=True) +\n    0.25*metrics[\"boundary_len\"].rank(pct=True)\n)\n\n# 6) Show top candidates\ntop = (metrics.sort_values(\"score\", ascending=False)\n              .query(\"n_tf >= 20 and boundary_len >= 20 and inside_pct >= 0.85\")\n              .head(10)\n              [[\"Cell_name\",\"n_total\",\"n_tf\",\"inside_pct\",\"boundary_len\",\"score\"]]\n)\ntop\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-10-06T20:13:25.757720Z","iopub.execute_input":"2025-10-06T20:13:25.757929Z","iopub.status.idle":"2025-10-06T20:13:28.449692Z","shell.execute_reply.started":"2025-10-06T20:13:25.757913Z","shell.execute_reply":"2025-10-06T20:13:28.448917Z"}},"outputs":[{"execution_count":139,"output_type":"execute_result","data":{"text/plain":"                                 Cell_name  n_total  n_tf  inside_pct  \\\n4491  a558c878-fbcb-43f9-9757-9505640922dc      615    68    0.990244   \n484   119f86a5-0683-4ab1-a4dd-0e2d1c9d2d16     1547   133    0.984486   \n5092  bb365830-df8b-40e8-abc3-84ce9f2f1b1f      531    43    0.996234   \n4724  ad669400-78c8-48ee-84e6-a9155a904a60      481    46    0.989605   \n715   1a23ba8e-1f76-4dea-af02-ba4b447a15f4      936    76    0.982906   \n4574  a8a3ff51-e7fe-4c07-902e-5614e7e3060f      434  