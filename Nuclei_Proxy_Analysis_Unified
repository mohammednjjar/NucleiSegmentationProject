l\n      2) Clip proxy mask to the cell boundary\n      3) No randomness (cell_id provided explicitly)\n    \"\"\"\n    cid = str(cell_id).strip()\n\n    # data for this cell\n    cell_data = df_tf_bound[df_tf_bound[\"Cell_name\"] == cid]\n    tf_data = cell_data[(cell_data[\"Inside_cell\"] == True) &\n                        (cell_data[\"Gene_name\"].isin(strong_nuclear_colors.keys()))]\n    if len(tf_data) < 3:\n        print(f\"Cell {cid} has too few strong nuclear marker molecules ({len(tf_data)}).\")\n        return\n\n    # boundary\n    row = df_boundaries[df_boundaries[\"feature_uID\"] == cid]\n    if row.empty:\n        print(f\"No boundary found for cell {cid}\")\n        return\n    bx = ast.literal_eval(row.iloc[0][\"boundaryX\"]); by = ast.literal_eval(row.iloc[0][\"boundaryY\"])\n    boundary_poly = Polygon(list(zip(bx, by)))\n\n    # DBSCAN → Alpha\n    pts = list(zip(tf_data[\"Centroid_X\"], tf_data[\"Centroid_Y\"]))\n    labels = DBSCAN(eps=eps, min_samples=min_samples).fit(pts).labels_\n    core = [p for p, l in zip(pts, labels) if l != -1]\n    if len(core) < 3:\n        print(f\"Cell {cid} did not form a dense cluster with DBSCAN.\")\n        return\n    try:\n        nucleus_mask = alphashape.alphashape(core, alpha=alpha)\n    except Exception:\n        nucleus_mask = MultiPoint(core).convex_hull\n\n    # clip to boundary (take largest polygon if multipolygon)\n    clipped = nucleus_mask.intersection(boundary_poly)\n    if hasattr(clipped, \"geoms\"):\n        polys = [p for p in clipped.geoms if p.geom_type == \"Polygon\"]\n        clipped = max(polys, key=lambda p: p.area) if polys else None\n    elif getattr(clipped, \"geom_type\", \"\") != \"Polygon\":\n        clipped = None\n\n    # counts\n    inside_n = int((cell_data[\"Inside_cell\"] == True).sum())\n    outside_n = int((cell_data[\"Inside_cell\"] == False).sum())\n    total = inside_n + outside_n\n    inside_pct = (inside_n / total * 100) if total else 0.0\n    outside_pct = (outside_n