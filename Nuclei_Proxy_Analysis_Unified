t_type":"stream"}],"execution_count":82},{"cell_type":"code","source":"# Cell 17 — Step 9 — Nuclei-Specific Binning (chunked + resumable; fast/exact modes)\n# Dr. Nuray’s Ninth Demand\n# Guarantees:\n# 1) Build nucleus mask from TFs inside cell\n# 2) Clip mask to cell boundary\n# 3) Bin all MERFISH molecules as Nucleus vs Cytoplasm\n\n# --- config ---\nMODE = \"fast\"           # \"fast\" (fixed alpha) or \"exact\" (optimizealpha)\nBATCH_SIZE = 250        # cells per batch\nOUT_PATH = \"MERFISH_nuclei_specific_binning.csv\"\n\nfrom shapely.prepared import prep\n\n# --- boundaries (once) ---\ncell_bound = {}\nfor cid, row in df_boundaries.set_index(\"feature_uID\").iterrows():\n    bx = ast.literal_eval(row[\"boundaryX\"]); by = ast.literal_eval(row[\"boundaryY\"])\n    cell_bound[cid] = Polygon(list(zip(bx, by)))\n\n# --- TFs strictly inside boundary (mask source) ---\ntf_inside = df_tf_bound[df_tf_bound[\"Inside_cell\"]].copy()\n\n# --- get pending cells (resume if output exists) ---\nall_cells = df_merfish[\"Cell_name\"].dropna().unique().tolist()\ndone_cells = set()\nif os.path.exists(OUT_PATH):\n    try:\n        tmp = pd.read_csv(OUT_PATH, usecols=[\"Cell_name\"])\n        done_cells = set(tmp[\"Cell_name\"].unique())\n    except Exception:\n        pass\npending_cells = [c for c in all_cells if c not in done_cells]\n\nprint(f\"Cells total={len(all_cells)}, done={len(done_cells)}, pending={len(pending_cells)}\")\n\n# --- util: build mask for one cell ---\nFIXED_ALPHA = 0.06\ndef build_mask_for_cell(cid):\n    poly = cell_bound.get(cid)\n    if poly is None:\n        return None\n    g = tf_inside[tf_inside[\"Cell_name\"] == cid]\n    if g.empty:\n        return None\n    pts = list(zip(g[\"Centroid_X\"], g[\"Centroid_Y\"]))\n    if len(pts) < 3:\n        return None\n    try:\n        if MODE == \"exact\" and len(pts) >= 4:\n            alpha = float(alphashape.optimizealpha(pts))\n            m = alphashape.alphashape(pts, alpha)\n        else:\n            m = alphashape.alphashape(pts, FIXED_ALPHA) if len(pts) >= 4 else MultiPoint(pts).convex_hull\n    except Exception:\n        m = MultiPoint(pts).convex_hull\n    if getattr(m, \"geom_type\", \"\") != \"Polygon\":\n        if hasattr(m, \"geoms\"):\n            polys = [p for p in m.geoms if p.geom_type == \"Polygon\"]\n            if not polys:\n                return None\n            m = max(polys, key=lambda p: p.area)\n        else:\n            return None\n    clip = m.intersection(poly)\n    if clip.is_empty:\n        return None\n    if getattr(clip, \"geom_type\", \"\") != \"Polygon\" and hasattr(clip, \"geoms\"):\n        polys = [p for p in clip.geoms if p.geom_type == \"Polygon\"]\n        if not polys:\n            return None\n        clip = max(polys, key=lambda p: p.area)\n    return clip\n\n# --- process in batches (resumable) ---\nheader_written = os.path.exists(OUT_PATH)\nfor s in tqdm(range(0, len(pending_cells), BATCH_SIZE), desc=f\"Processing batches (MODE={MODE})\"):\n    batch_cells = pending_cells[s:s+BATCH_SIZE]\n\n    # build masks\n    masks = {cid: build_mask_for_cell(cid) for cid in batch_cells if build_mask_for_cell(cid) is not None}\n\n    # bin MERFISH molecules\n    batch_df = df_merfish[df_merfish[\"Cell_name\"].isin(batch_cells)].copy()\n    if batch_df.empty:\n        continue\n    batch_df[\"Bin\"] = \"Outside_cell\"\n    out_rows = []\n    for cid, sub in batch_df.groupby(\"Cell_name\"):\n        poly = cell_bound.get(cid)\n        if poly is None or sub.empty:\n            continue\n        xs, ys = sub[\"Centroid_X\"].to_numpy(), sub[\"Centroid_Y\"].to_numpy()\n        ppoly = prep(poly)\n        inside = np.fromiter((ppoly.contains(Point(x, y)) for x, y in zip(xs, ys)), bool, count=len(xs))\n        if not inside.any():\n            continue\n        sub_in = sub.loc[inside].copy()\n        sub_in[\"Bin\"] = \"Cytoplasm\"\n        mask = masks.get(cid)\n        if mask is not None:\n            pmask = prep(mask)\n            in_mask = np.fromiter((pmask.contains(Point(x, y)) for x, y in zip(sub_in[\"Centroid_X\"], sub_in[\"Centroid_Y\"])),\n                                  bool, count=len(sub_in))\n            if in_mask.any():\n                sub_in.loc[in_mask, \"Bin\"] = \"Nucleus\"\n        out_rows.append(sub_in)\n    if not out_rows:\n        continue\n    out_batch = pd.concat(out_rows, ignore_index=True)\n    out_batch.to_csv(OUT_PATH, mode=\"a\", header=not header_written, index=False)\n    header_written = True\n\n# --- summary if output exists ---\nif os.path.exists(OUT_PATH):\n    df_bins = pd.read_csv(OUT_PATH)\n    genes_of_interest = tf_genes  # unified global list\n    summary_gene = (\n        df_bins[df_bins[\"Gene_name\"].isin(genes_of_interest)]\n        .groupby([\"Gene_name\",\"Bin\"]).size().unstack(fill_value=0)[[\"Cytoplasm\",\"Nucleus\"]]\n    )\n    display(summary_gene)\n    per_cell_summary = (\n        df_bins.groupby([\"Cell_name\",\"Bin\"]).size().unstack(fill_value=0)[[\"Cytoplasm\",\"Nucleus\"]]\n    )\n    per_cell_summary[\"Total_in_cell\"] = per_cell_summary[\"Cytoplasm\"] + per_cell_summary[\"Nucleus\"]\n    per_cell_summary[\"Nucleus_%\"] = (100 * per_cell_summary[\"Nucleus\"] / per_cell_summary[\"Total_in_cell\"]).round(2)\n    display(per_cell_summary[per_cell_summary[\"Total_in_cell\"] > 0].sort_values(\"Nucleus_%\", ascending=False))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-10-12T18:36:32.896679Z","iopub.execute_input":"2025-10-12T18:36:32.896847Z","iopub.status.idle":"2025-10-12T18:36:58.586144Z","shell.execute_reply.started":"2025-10-12T18:36:32.896833Z","shell.execute_reply":"2025-10-12T18:36:58.585554Z"}},"outputs":[{"name":"stdout","text":"Cells total=6966, done=6313, pending=653\n","output_type":"stream"},{"name":"stderr","text":"Processing batches (MODE=fast): 100%|██████████| 3/3 [00:00<00:00, 13.42it/s]\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"Bin        Cytoplasm  Nu