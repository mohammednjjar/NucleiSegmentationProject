p.cos(t), np.sin(t)]) * scale)).T\n    return Polygon(ellipse)\n\ndef _kde_hull(points, k=10, q=0.65):\n    if len(points) < 3: return None\n    X = np.asarray(points); k = min(k, len(points)-1)\n    nbrs = NearestNeighbors(n_neighbors=k+1).fit(X)\n    dists, _ = nbrs.kneighbors(X)\n    dens = 1.0 / (dists[:, -1] + 1e-9)\n    keep = X[dens >= np.quantile(dens, q)]\n    return MultiPoint([tuple(p) for p in keep]).convex_hull if len(keep) >= 3 else None\n\ndef plot_all_methods_for_chosen(alpha_fixed=0.05, eps=10, min_samples=3):\n    cid = str(chosen_cell_id).strip()\n\n    # --- data ---\n    cell = df_tf_bound[df_tf_bound[\"Cell_name\"] == cid]\n    # use ONLY nuclear TFs inside\n    tf = cell[(cell[\"Inside_cell\"] == True) & (cell[\"Gene_name\"].isin(nuclear_tfs))]\n    row  = df_boundaries[df_boundaries[\"feature_uID\"] == cid]\n    if row.empty: raise RuntimeError(f\"No boundary for cell {cid}\")\n    bx = ast.literal_eval(row.iloc[0][\"boundaryX\"])\n    by = ast.literal_eval(row.iloc[0][\"boundaryY\"])\n    boundary_poly = Polygon(list(zip(bx, by)))\n\n    pts = list(zip(tf[\"Centroid_X\"], tf[\"Centroid_Y\"]))\n    mp  = MultiPoint(pts) if len(pts) else None\n\n    # --- methods ---\n    methods = {}\n    methods[\"Convex Hull\"]      = (mp.convex_hull if mp else None)\n    methods[\"Alpha Shape\"]      = (alphashape.alphashape(pts, alpha_fixed) if _HAS_ALPHA and len(pts)>=4 else (mp.convex_hull if mp else None))\n    if len(pts) >= 2:\n        lbls = DBSCAN(eps=eps, min_samples=min_samples).fit(pts).labels_\n        core = [p for p,l in zip(pts,lbls) if l!=-1]\n        methods[\"DBSCAN+Hull\"]  = MultiPoint(core).convex_hull if len(core)>=3 else (mp.convex_hull if mp else None)\n    else:\n        methods[\"DBSCAN+Hull\"]  = (mp.convex_hull if mp else None)\n    methods[\"Density Estimate\"] = None\n    methods[\"GMM Ellipse\"]      = _gmm_ellipse(pts, scale=1.5) if len(pts)>=4 else (mp.convex_hull if mp else None)\n    try:\n        _vor = Voronoi(pts) if l