for cid, row in df_boundaries.set_index(\"feature_uID\").iterrows():\n    bx = ast.literal_eval(row[\"boundaryX\"]); by = ast.literal_eval(row[\"boundaryY\"])\n    cell_bound[cid] = Polygon(list(zip(bx, by)))\n\n# --- TFs strictly inside boundary (mask source) ---\ntf_inside = df_tf_bound[df_tf_bound[\"Inside_cell\"]].copy()\n\n# --- get pending cells (resume if output exists) ---\nall_cells = df_merfish[\"Cell_name\"].dropna().unique().tolist()\ndone_cells = set()\nif os.path.exists(OUT_PATH):\n    try:\n        tmp = pd.read_csv(OUT_PATH, usecols=[\"Cell_name\"])\n        done_cells = set(tmp[\"Cell_name\"].unique())\n    except Exception:\n        pass\npending_cells = [c for c in all_cells if c not in done_cells]\n\nprint(f\"Cells total={len(all_cells)}, done={len(done_cells)}, pending={len(pending_cells)}\")\n\n# --- util: build mask for one cell (fast/exact) ---\nFIXED_ALPHA = 0.06\n\ndef build_mask_for_cell(cid):\n    poly = cell_bound.get(cid)\n    if poly is None:\n        return None\n    g = tf_inside[tf_inside[\"Cell_name\"] == cid]\n    if g.empty:\n        return None\n    pts = list(zip(g[\"Centroid_X\"].to_numpy(), g[\"Centroid_Y\"].to_numpy()))\n    if len(pts) < 3:\n        return None\n    # alpha\n    try:\n        if MODE == \"exact\" and len(pts) >= 4:\n            alpha = float(alphashape.optimizealpha(pts))\n            m = alphashape.alphashape(pts, alpha)\n        else:\n            # fast: fixed alpha; fallback hull\n            m = alphashape.alphashape(pts, FIXED_ALPHA) if len(pts) >= 4 else MultiPoint(pts).convex_hull\n    except Exception:\n        m = MultiPoint(pts).convex_hull\n    # ensure polygon\n    if getattr(m, \"geom_type\", \"\") != \"Polygon\":\n        if hasattr(m, \"geoms\"):\n            polys = [p for p in m.geoms if p.geom_type == \"Polygon\"]\n            if not polys:\n                return None\n            m = max(polys, key=lambda p: p.area)\n        else:\n            return None\n    # clip to boundary\n    clip = m.intersection(poly)\n    if clip.is_empty:\n        return None\n    if getattr(clip, \"geom_type\", \"\") != \"Polygon\" and hasattr(clip, \"geoms\"):\n        polys = [p for p in clip.geoms if p.geom_type == \"Polygon\"]\n        if not polys:\n            return None\n        clip = max(polys, key=lambda p: p.area)\n    return clip\n\n# --- process in batches; append to CSV; resumable ---\nheader_written = os.path.exists(OUT_PATH)\nfor s in tqdm(range(0, len(pending_cells), BATCH_SIZE), desc=f\"Processing batches (MODE={MODE})\"):\n    batch_cells = pending_cells[s:s+BATCH_SIZE]\n\n    # build masks for batch\n    masks = {}\n    for cid in batch_cells:\n        m = build_mask_for_cell(cid)\n        if m is not None:\n            masks[cid] = m\n\n    # bin MERFISH molecules for batch\n    batch_df = df_merfish[df_merfish[\"Cell_name\"].isin(batch_cells)].copy()\n    if batch_df.empty:\n        continue\n    batch_df[\"Bin\"] = \"Outside_cell\"\n\n    out_rows = []\n    for cid, sub in batch_df.groupby(\"Cell_name\"):\n        poly = cell_bound.get(cid)\n        if poly is None or sub.empty:\n            continue\n        xs = sub[\"Centroid_X\"].to_numpy(); ys = sub[\"Centroid_Y\"].to_numpy()\n        ppoly = prep(poly)\n        inside = np.fromiter((ppoly.contains(Point(x, y)) for x, y in zip(xs, ys)), bool, count=len(xs))\n        if not inside.any():\n            continue\n        sub_in = sub.loc[inside].copy()\n        sub_in[\"Bin\"] = \"Cytoplasm\"\n        mask = masks.get(cid)\n        if mask is not None:\n            pmask = prep(mask)\n            in_mask = np.fromiter((pmask.contains(Point(x, y)) for x, y in zip(sub_in[\"Centroid_X\"], sub_in[\"Centroid_Y\"])),\n                                  bool, count=len(sub_in))\n            if in_mask.any():\n                sub_in.loc[in_mask, \"Bin\"] = \"Nucleus\"\n        out_rows.append(sub_in)\n\n    if not out_rows:\n        continue\n\n    out_batch = pd.concat(out_rows, ignore_index=True)\n\n    # append\n    out_batch.to_csv(OUT_PATH, mode=\"a\", header=not header_written, index=False)\n    header_written = True\n\n# --- if finished (or partially, if you stop here) you can compute summaries from OUT_PATH ---\nif os.path.exists(OUT_PATH):\n    df_bins = pd.read_csv(OUT_PATH)\n    # per-gene (nuclear genes)\n    genes_of_interest = nuclear_tfs + nuclear_non_tfs\n    summary_gene = (\n        df_bins[df_bins[\"Gene_name\"].isin(genes_of_interest)]\n        .groupby([\"Gene_name\",\"Bin\"]).size().unstack(fill_value=0)[[\"Cytoplasm\",\"Nucleus\"]]\n    )\n    display(summary_gene)\n\n    # per-cell\n    per_cell_summary = (\n        df_bins.groupby([\"Cell_name\",\"Bin\"]).size().unstack(fill_value=0)[[\"Cytoplasm\",\"Nucleus\"]]\n    )\n    per_cell_summary[\"Total_in_cell\"] = per_cell_summary[\"Cytoplasm\"] + per_cell_summary[\"Nucleus\"]\n    per_cell_summary[\"Nucleus_%\"] = (100 * per_cell_summary[\"Nucleus\"] / per_cell_summary[\"Total_in_cell\"]).round(2)\n    display(per_cell_summary[per_cell_summary[\"Total_in_cell\"] > 0].sort_values(\"Nucleus_%\", ascending=False))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-10-06T20:14:28.304948Z","iopub.execute_input":"2025-10-06T20:14:28.305181Z","iopub.status.idle":"2025-10-06T20:14:53.621341Z","shell.execute_reply.started":"2025-10-06T20:14:28.305165Z","shell.execute_reply":"2025-10-06T20:14:53.620601Z"}},"outputs":[{"name":"stdout","text":"Cells total=6966, done=6313, pending=653\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"Processing batches (MODE=fast):   0%|          | 0/3 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"606acca1c35d4a0dbcc1368089638bd6"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Bin        Cytoplasm  Nucleus\nGene_name                    \nAr              7514     8831\nCcnd2           3245     3723\nCdkn1a          2993     2934\nEbf3      